    "profiles.remove": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil entfernen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove profile"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profili kaldır"
          }
        }
      }
    },
    "profiles.removeChoice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Von diesem Gerät entfernen“: Das Profil verschwindet nur hier, mit seinen Einstellungen, seinem Stand und den IPTV-Zugängen, die kein anderes Profil hat. In iCloud und auf deinen anderen Geräten bleibt es; über „Vorhandenes Profil hinzufügen“ holst du es zurück.\n„Überall löschen“: Das Profil verschwindet von allen Geräten mit deinem Apple-Account, und seine Daten in iCloud werden endgültig gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Remove from this device”: the profile disappears only here, together with its settings, its progress and the IPTV accounts no other profile holds. It stays in iCloud and on your other devices; “Add existing profile” brings it back.\n“Delete everywhere”: the profile disappears from every device with your Apple Account, and its data in iCloud is deleted for good. This cannot be undone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Bu cihazdan kaldır”: Profil yalnızca burada kaybolur; ayarları, ilerlemesi ve başka hiçbir profilde olmayan IPTV erişimleriyle birlikte. iCloud’da ve diğer cihazlarında kalır; “Mevcut profili ekle” ile geri getirirsin.\n“Her yerden sil”: Profil, Apple hesabınla kullanılan tüm cihazlardan kaybolur ve iCloud’daki verileri kalıcı olarak silinir. Bu işlem geri alınamaz."
          }
        }
      }
    },
    "profiles.removeConfirm": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Profil entfernen? Seine Einstellungen und sein Stand gehen mit. Ein Jellyfin-Zugang, den kein anderes Profil hat, wird dabei abgemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this profile? Its settings and its progress go with it. A Jellyfin access no other profile holds is signed out in the process."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu profil kaldırılsın mı? Ayarları ve ilerlemesi de gider. Başka hiçbir profilde bulunmayan bir Jellyfin erişiminin oturumu kapatılır."
          }
        }
      }
    },
    "profiles.removeEverywhere": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überall löschen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete everywhere"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her yerden sil"
          }
        }
      }
    },
    "profiles.removeHere": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von diesem Gerät entfernen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove from this device"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazdan kaldır"
          }
        }
      }
    },
    "profiles.singleHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist ein Profil angelegt. „Profil anlegen“ gibt jedem im Haushalt seine eigene Startseite, seine eigenen IPTV-Zugänge und seinen eigenen Stand — auch ohne eigenes Jellyfin-Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One profile is set up. “Add profile” gives everyone in the household their own home screen, their own IPTV accounts and their own progress — even without a Jellyfin account of their own."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir profil oluşturuldu. “Profil ekle”, evdeki herkese kendi başlangıç ekranını, kendi IPTV erişimlerini ve kendi ilerlemesini verir — kendi Jellyfin hesabı olmasa bile."
          }
        }
      }
    },
    "profiles.startAs": {
      "extractionState": "manual",
      "localizations": {
        "de": {
