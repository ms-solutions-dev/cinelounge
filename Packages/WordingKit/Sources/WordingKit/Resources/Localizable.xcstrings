    "state.offline.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App hat nichts versucht: keine Anmeldung, keine Abfrage, kein Kreisel. Was auf dem Gerät liegt, läuft sofort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app tried nothing: no sign-in, no request, no spinner. What’s on the device plays right away."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama hiçbir şey denemedi: oturum açma yok, sorgu yok, döner çember yok. Cihazda duran hemen oynar."
          }
        }
      }
    },
