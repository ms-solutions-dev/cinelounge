          "stringUnit": {
            "state": "translated",
            "value": "Görülebilen şey oynatılabilir — yoksa sınır bir tuzak olurdu."
          }
        }
      }
    },
    "childLock.doorReason.start": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Reiter zeigt nur, was er zeigen darf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tab only shows what it is allowed to show."
