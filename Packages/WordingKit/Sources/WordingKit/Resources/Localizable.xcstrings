    "setup.jellyfin.otherUserHint": {
      "comment": "Setup A5: why the question about the other user",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freigeben kann jeder angemeldete Jellyfin-Nutzer. Übernimmst du den anderen Nutzer, schaut dieses Profil mit dessen Bibliothek, Verlauf und Grenzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any signed-in Jellyfin user can approve a code. If you take over the other user, this profile watches with their library, history and limits."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodu oturum açmış her Jellyfin kullanıcısı onaylayabilir. Diğer kullanıcıyı alırsan bu profil onun kitaplığı, geçmişi ve sınırlarıyla izler."
          }
        }
      }
    },
