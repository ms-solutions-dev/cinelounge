    "state.live.allHidden.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liste ist nicht leer, sie ist versteckt. In den Einstellungen lässt sich wieder einblenden."
          }
        },
        "en": {
