    "profiles.leaveChoice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Profil gehört einem anderen Apple-Account. Du verlässt die Freigabe: Es verschwindet von deinen Geräten, beim Besitzer bleibt es unverändert. Wieder hinein kommst du nur mit einem neuen Freigabe-Link."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This profile belongs to another Apple Account. You leave the share: it disappears from your devices and stays unchanged for its owner. You can only rejoin with a new share link."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu profil başka bir Apple hesabına ait. Paylaşımdan ayrılırsın: Profil senin cihazlarından kaybolur, sahibinde olduğu gibi kalır. Yeniden katılmak için yeni bir paylaşım bağlantısı gerekir."
          }
        }
      }
    },
