    "state.camera.denied.action": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarları aç"
          }
        }
      }
    },
    "state.camera.denied.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Lesen des Codes am Fernseher braucht CineLounge die Kamera. Du kannst das in den Einstellungen ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CineLounge needs the camera to read the code on your TV. You can change this in Settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CineLounge, televizyondaki kodu okumak için kameraya ihtiyaç duyar. Bunu Ayarlar'da değiştirebilirsin."
          }
        }
      }
    },
    "state.camera.denied.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera ist nicht freigegeben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is off"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera erişimi kapalı"
          }
        }
      }
    },
    "state.cellular.paused.action": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeln ändern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the rules"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuralları değiştir"
          }
        }
      }
    },
    "state.cellular.paused.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Nur im WLAN laden“ ist eingeschaltet. Die Übertragungen laufen von allein weiter, sobald ein WLAN da ist — nichts geht verloren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Only download on Wi-Fi” is on. Transfers resume by themselves once Wi-Fi is back — nothing is lost."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "„Yalnızca Wi-Fi’de indir“ açık. Aktarımlar Wi-Fi gelir gelmez kendiliğinden sürer — hiçbir şey kaybolmaz."
          }
        }
      }
    },
    "state.cellular.paused.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angehalten — du bist im Mobilfunk"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused — you’re on cellular"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duraklatıldı — mobil veridesin"
          }
        }
      }
    },
    "state.cert.ask.action": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zertifikat ansehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review certificate"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sertifikayı incele"
          }
        }
      }
    },
    "state.cert.ask.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server weist sich mit einem unbekannten oder geänderten Zertifikat aus. Vergleiche seinen Fingerabdruck mit dem, der auf deinem Server steht — stimmen sie überein, ist die Verbindung echt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server presents an unknown or changed certificate. Compare its fingerprint with the one shown on your server — if they match, the connection is genuine."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu bilinmeyen ya da değişmiş bir sertifikayla kimliğini gösteriyor. Parmak izini sunucunuzda görünenle karşılaştırın — aynıysa bağlantı gerçektir."
          }
        }
      }
    },
    "state.cert.ask.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Server bestätigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm this server"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sunucuyu onaylayın"
          }
        }
      }
    },
    "state.cert.player.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server antwortet — die Wiedergabe nutzt aber einen eigenen Netzweg, der das selbst ausgestellte Zertifikat nicht kennt. Abhilfe: das Wurzelzertifikat auf dem Gerät installieren oder die Adresse ohne https eintragen, mit Port 8096."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server answers — but playback uses its own network path, which does not know the self-signed certificate. To fix it, install the root certificate on the device or enter the address without https, with port 8096."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu yanıt veriyor; ancak oynatma, kendi imzalı sertifikayı tanımayan ayrı bir ağ yolu kullanır. Çözüm: kök sertifikayı cihaza yükleyin ya da adresi https olmadan, 8096 portuyla girin."
          }
        }
      }
    },
    "state.cert.player.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Systemplayer traut dem Zertifikat nicht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system player does not trust the certificate"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem oynatıcısı sertifikaya güvenmiyor"
          }
        }
      }
    },
    "state.downloads.meanwhile": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange zu den Downloads"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to downloads meanwhile"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu arada indirilenlere git"
          }
        }
      }
    },
    "state.favorites.empty.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du markierst, sammelt sich hier — quellenübergreifend."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whatever you mark collects here, across all sources."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşaretlediklerin burada toplanır; tüm kaynaklardan."
          }
        }
      }
    },
    "state.favorites.empty.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Favoriten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No favourites yet"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz favori yok"
          }
        }
      }
    },
    "state.jellyfin.fault.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er ist erreichbar, kann diese Anfrage aber gerade nicht beantworten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is reachable but cannot answer this request right now."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucuya ulaşılıyor ama bu isteği şu anda yanıtlayamıyor."
          }
        }
      }
    },
    "state.jellyfin.fault.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin meldet eine Störung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin reports a problem"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin bir sorun bildiriyor"
          }
        }
      }
    },
    "state.jellyfin.stalled.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat geantwortet — es scheitert nur die Wiedergabe dieses Titels. Entweder führt er etwas, das dieses Gerät nicht dekodiert, oder das Umrechnen bricht ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server answered — only playback of this title fails. Either it carries something this device cannot decode, or the transcode breaks off."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu yanıt verdi — yalnızca bu içeriğin oynatılması başarısız oluyor. Ya cihazın çözemediği bir şey içeriyor ya da dönüştürme kopuyor."
          }
        }
      }
    },
    "state.jellyfin.stalled.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Titel läuft nicht an"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The title will not start"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçerik başlamıyor"
          }
        }
      }
    },
    "state.library.empty.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server führt hier keine Titel. Sobald etwas dazukommt, steht es hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server holds no titles here. As soon as something is added, it appears here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucuda burada içerik yok. Bir şey eklendiğinde burada görünür."
          }
        }
      }
    },
    "state.library.empty.title": {
      "extractionState": "manual",
      "localizations": {
