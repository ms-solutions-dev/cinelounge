    "childLock.doorReason.melden": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Meldeweg aus Richtlinie 1.2 — hinter einer PIN wäre er keiner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reporting path from guideline 1.2 — behind a PIN it would not be one."
