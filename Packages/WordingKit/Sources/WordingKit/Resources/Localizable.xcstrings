      }
    },
    "childLock.doorReason.pinRuecksetzung": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier wird die Kindersicherung eines anderen Geräts sofort aufgehoben — ohne die Frist, die sie dort schützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This lifts the parental controls of another device at once — without the waiting period that protects them there."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada başka bir cihazın ebeveyn denetimi hemen kaldırılır — orada onu koruyan bekleme süresi olmadan."
          }
        }
