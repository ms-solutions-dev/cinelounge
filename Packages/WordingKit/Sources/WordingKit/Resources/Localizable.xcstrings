    "childLock.doorReason.speicher": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Weg aus dem Vorrat heraus gehört zum Vorrat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The way out of the downloads belongs to the downloads."
