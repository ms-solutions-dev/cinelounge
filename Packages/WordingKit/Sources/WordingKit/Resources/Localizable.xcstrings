    "setup.pin.text": {
      "comment": "Setup A3K: why the household PIN comes before a child profile",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne PIN ließe sich ein Kinderprofil mit zwei Drücken verlassen. Die PIN schützt auf diesem Gerät das Verlassen von Kinderprofilen und die Einstellungen. Sie bleibt hier und wandert nicht über iCloud."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a PIN, a child profile could be left with two presses. On this device the PIN guards leaving child profiles and the settings. It stays here and does not travel through iCloud."
