    "childLock.doorReason.einstellungenOffen": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Darstellung, Wiedergabe, Diagnose und die Angaben über die App — nichts davon hebt eine Grenze auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appearance, playback, diagnostics and the information about the app — none of it lifts a limit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görünüm, oynatma, tanılama ve uygulama bilgileri — hiçbiri bir sınırı kaldırmaz."
          }
        }
      }
    },
    "childLock.doorReason.favoriten": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorit wird nur, was schon sichtbar war."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only what was already visible can become a favourite."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca zaten görünür olan favori olabilir."
          }
        }
