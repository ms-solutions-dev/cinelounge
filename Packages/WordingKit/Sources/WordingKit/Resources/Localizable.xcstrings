    "childLock.doorReason.einstellungen": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von hier führt jeder Weg weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every path leads on from here."
