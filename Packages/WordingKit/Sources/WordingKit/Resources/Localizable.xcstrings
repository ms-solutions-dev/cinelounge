    "state.net.jellyfin.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server ist gerade nicht erreichbar. Läuft er, und ist dieses Gerät im selben Netz? Von unterwegs braucht es den Tunnel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server cannot be reached right now. Is it running, and is this device on the same network? Away from home you need the tunnel."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucuya şu an ulaşılamıyor. Çalışıyor mu, bu cihaz aynı ağda mı? Evin dışındayken tünel gerekir."
          }
        }
      }
    },
    "state.net.jellyfin.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Antwort von Jellyfin"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No answer from Jellyfin"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin yanıt vermiyor"
          }
        }
      }
    },
    "state.net.none.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät hängt gerade an keinem Netz. Sobald die Verbindung zurück ist, lädt die Seite von selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device is not on a network right now. The page reloads by itself once the connection is back."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihaz şu anda bir ağa bağlı değil. Bağlantı geri geldiğinde sayfa kendiliğinden yüklenir."
          }
        }
      }
    },
    "state.net.none.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Netzwerkverbindung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No network connection"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağ bağlantısı yok"
          }
        }
      }
    },
    "state.net.portals.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der CL-Server läuft auf einem Rechner in deinem Heimnetz. Läuft er, und stimmt seine Adresse?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The CL server runs on a machine on your home network. Is it running, and is its address right?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CL-Server ev ağındaki bir makinede çalışır. Çalışıyor mu, adresi doğru mu?"
          }
        }
      }
    },
    "state.net.portals.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der CL-Server antwortet nicht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The CL-Server is not answering"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CL-Server yanıt vermiyor"
          }
        }
      }
    },
    "state.net.xtream.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter antwortet nicht. Er kommt direkt aus dem Internet — am Heimnetz oder am Tunnel liegt es selten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider is not answering. It comes straight from the internet — your home network or the tunnel is rarely the cause."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcı yanıt vermiyor. Doğrudan internetten gelir — sorun nadiren ev ağında ya da tünelde olur."
          }
        }
      }
    },
    "state.net.xtream.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Antwort vom Anbieter"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No answer from the provider"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcı yanıt vermiyor"
          }
        }
      }
    },
