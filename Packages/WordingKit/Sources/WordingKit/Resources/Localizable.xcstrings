    "pairing.devicesEmpty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Gerät eingetragen. Jedes Gerät trägt sich beim nächsten Abgleich ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No device listed yet. Each device adds itself at its next sync."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz cihaz yok. Her cihaz bir sonraki eşitlemede kendini ekler."
          }
        }
      }
    },
    "pairing.devicesHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo dieses Profil läuft, zuletzt benutzt zuerst. Wähle ein Gerät, um es umzubenennen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where this profile is used, most recent first. Choose a device to rename it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu profilin kullanıldığı yerler, en son kullanılan önce. Yeniden adlandırmak için bir cihaz seç."
          }
        }
      }
    },
    "pairing.end": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freigabe beenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop sharing"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşımı durdur"
          }
        }
      }
    },
    "pairing.endConfirm": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freigabe beenden?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop sharing?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşım durdurulsun mu?"
          }
        }
      }
    },
    "pairing.endHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Link wird damit ungültig, und alle anderen Geräte verlieren dieses Profil. Auf diesem Gerät bleibt es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link becomes invalid and every other device loses this profile. It stays on this device."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı geçersiz olur ve diğer tüm cihazlar bu profili kaybeder. Bu cihazda kalır."
          }
        }
      }
    },
    "pairing.expired": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code ist abgelaufen. Niemand hat ihn in den fünf Minuten gescannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code has expired. Nobody scanned it within the five minutes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodun süresi doldu. Beş dakika içinde kimse taramadı."
          }
        }
      }
    },
    "pairing.failed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das hat nicht geklappt. Bitte noch einmal versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That did not work. Please try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işe yaramadı. Lütfen tekrar deneyin."
          }
        }
      }
    },
    "pairing.give": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Profil weitergeben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hand this profile on"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu profili aktar"
          }
        }
      }
    },
    "pairing.giveAction": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Code zeigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show code"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodu göster"
          }
        }
      }
    },
    "pairing.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Profil lebt in iCloud und kann auf mehreren Geräten zugleich stehen — auch auf einem, das jemand anderem gehört. Gezeigt wird dabei nie der Teilen-Link selbst, sondern ein Code, der nach fünf Minuten verfällt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A profile lives in iCloud and can be on several devices at once — even on one that belongs to someone else. What you see is never the sharing link itself, but a code that expires after five minutes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir profil iCloud'da yaşar ve aynı anda birden fazla cihazda bulunabilir — başkasına ait bir cihazda bile. Ekranda hiçbir zaman paylaşım bağlantısının kendisi değil, beş dakika sonra geçersiz olan bir kod görünür."
          }
        }
      }
    },
    "pairing.leave": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freigabe verlassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave the share"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşımdan ayrıl"
          }
        }
      }
    },
    "pairing.leaveConfirm": {
      "extractionState": "manual",
      "localizations": {
        "de": {
