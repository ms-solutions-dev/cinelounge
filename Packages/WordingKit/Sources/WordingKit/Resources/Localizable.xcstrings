        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şey bulunamadı"
          }
        }
      }
    },
    "state.setup.none.action": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einrichten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kur"
          }
        }
      }
    },
    "state.setup.none.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin, IPTV oder der CL-Server — eines genügt zum Anfangen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin, IPTV or the CL server — one is enough to begin."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin, IPTV ya da CL-Server — başlamak için biri yeter."
          }
        }
      }
    },
    "state.setup.none.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts eingerichtet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing set up yet"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz bir şey kurulmadı"
          }
        }
      }
    },
    "state.sync": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt abgleichen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync now"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi eşitle"
          }
        }
      }
    },
    "state.tv.unreachable.action": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch einmal suchen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search again"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden ara"
          }
        }
      }
    },
    "state.tv.unreachable.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist der Apple TV eingeschaltet und CineLounge darauf geöffnet? Beide Geräte müssen im selben Netz sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is the Apple TV on with CineLounge open? Both devices need to be on the same network."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV açık ve CineLounge çalışıyor mu? İki cihaz da aynı ağda olmalı."
          }
        }
      }
    },
    "state.tv.unreachable.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fernseher antwortet nicht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV isn’t responding"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Televizyon yanıt vermiyor"
          }
        }
      }
    },
    "state.xtream.busy.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Zugang erlaubt eine Wiedergabe zur Zeit. Läuft gerade etwas auf einem anderen Gerät?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account allows one stream at a time. Is something playing on another device?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesap aynı anda tek yayına izin verir. Başka bir cihazda bir şey mi oynuyor?"
          }
        }
      }
    },
    "state.xtream.busy.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die eine Verbindung ist belegt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your one connection is in use"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek bağlantın kullanımda"
          }
        }
      }
    },
    "state.xtream.expired.action": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu IPTV"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to IPTV"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "IPTV’ye git"
          }
        }
      }
    },
    "state.xtream.expired.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter weist Benutzername oder Kennwort dieses IPTV-Zugangs zurück. Beides steht unter IPTV."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider is rejecting this IPTV account's username or password. Both live under IPTV."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcı bu IPTV erişimi için kullanıcı adını ya da parolayı kabul etmiyor. İkisi de IPTV altında."
          }
        }
      }
    },
    "state.xtream.expired.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugang gilt nicht mehr"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your provider access expired"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişim artık geçerli değil"
          }
        }
      }
    },
    "state.xtream.missing.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugang führt ihn nicht mehr. Ein Abgleich holt die aktuelle Liste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account no longer lists it. A sync fetches the current list."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabında artık listelenmiyor. Eşitleme güncel listeyi getirir."
          }
        }
      }
    },
    "state.xtream.missing.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Sender gibt es nicht mehr"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This channel is gone"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kanal artık yok"
          }
        }
      }
    },
    "state.xtream.raw.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter gibt den Sender als rohen Transportstrom heraus. Die App packt ihn selbst um — hier ist sie damit nicht durchgekommen: Entweder führt der Strom etwas, das dieses Gerät nicht dekodiert, oder der Anbieter liefert gerade zu knapp."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider hands out this channel as a raw transport stream. The app repackages it itself — and did not get through here: either the stream carries something this device cannot decode, or the provider is currently supplying too little."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcı bu kanalı ham taşıma akışı olarak veriyor. Uygulama onu kendisi yeniden paketliyor — ama burada başaramadı: ya akış bu cihazın çözemediği bir şey taşıyor ya da sağlayıcı şu anda çok az veri gönderiyor."
          }
        }
      }
    },
    "state.xtream.raw.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Sender kommt nur roh"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This channel comes only as a raw stream"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kanal yalnızca ham akış olarak geliyor"
          }
        }
      }
    },
