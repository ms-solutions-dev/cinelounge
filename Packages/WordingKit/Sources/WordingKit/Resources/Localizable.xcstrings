          "stringUnit": {
            "state": "translated",
            "value": "Bir sekme yalnızca göstermesine izin verileni gösterir."
          }
        }
      }
    },
    "childLock.doorReason.suche": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suche findet nur, was dieses Konto sehen darf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search only finds what this account may see."
