            "value": "Yetişkin kanallarını göster"
          }
        }
      }
    },
    "childLock.ask.change.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Ändern zuerst die alte PIN — sonst wäre sie in dem Augenblick überflüssig, in dem jemand sie ändern will."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To change it, first the old PIN — otherwise it would be pointless the moment someone wants to change it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değiştirmek için önce eski PIN — yoksa biri değiştirmek istediği anda anlamsız olurdu."
          }
        }
      }
    },
    "childLock.ask.create.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier Ziffern. Sie gelten nur auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four digits. They apply on this device only."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dört hane. Yalnızca bu cihazda geçerli."
          }
        }
      }
    },
    "childLock.ask.switchAccount.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kontowechsel hebt jede Grenze auf. Dafür braucht es die PIN."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching accounts lifts every limit. That needs the PIN."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap değiştirmek her sınırı kaldırır. Bunun için PIN gerekir."
          }
        }
      }
    },
    "childLock.deviceLock": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerätesperre"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device lock"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz kilidi"
          }
        }
      }
    },
    "childLock.deviceLock.scope": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange das Gerät gesperrt ist, sind Live, CL-Server und Sport ausgeblendet – dort greifen keine Altersangaben. Für getrennte Regeln lieber Kinderprofile mit einer Profil-PIN nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While the device is locked, Live, CL server and Sports are hidden – age ratings don’t apply there. For separate rules, use kids’ profiles with a profile PIN instead."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz kilitliyken Canlı, CL-Server ve Spor gizlenir – oralarda yaş sınırları geçerli değildir. Ayrı kurallar için bunun yerine çocuk profilleri ve profil PIN’i kullanın."
          }
        }
      }
    },
