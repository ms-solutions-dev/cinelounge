    "profiles.icloudDelete": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle meine iCloud-Daten löschen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all my iCloud data"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm iCloud verilerimi sil"
          }
        }
      }
    },
    "profiles.icloudDelete.confirm": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wirklich alle iCloud-Daten löschen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Really delete all iCloud data?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm iCloud verileri gerçekten silinsin mi?"
          }
        }
      }
    },
    "profiles.icloudDelete.do": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endgültig löschen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete permanently"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalıcı olarak sil"
          }
        }
      }
    },
    "profiles.icloudDelete.done": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine iCloud-Daten sind gelöscht. Starte die App neu, damit sie sich neu einrichtet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iCloud data has been deleted. Restart the app so it sets itself up again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud verilerin silindi. Uygulamanın yeniden kurulması için onu yeniden başlat."
          }
        }
      }
    },
    "profiles.icloudDelete.failed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Löschen ist gescheitert. Versuche es später noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting failed. Please try again later."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silme başarısız oldu. Lütfen daha sonra tekrar dene."
          }
        }
      }
    },
    "profiles.icloudDelete.noAccount": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein iCloud-Konto angemeldet – es gibt nichts zu löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No iCloud account signed in – there's nothing to delete."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum açmış bir iCloud hesabı yok – silinecek bir şey yok."
          }
        }
      }
    },
    "profiles.icloudDelete.offline": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ist gerade nicht erreichbar. Versuche es später noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud can't be reached right now. Please try again later."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud'a şu anda ulaşılamıyor. Lütfen daha sonra tekrar dene."
          }
        }
      }
    },
    "profiles.icloudDelete.running": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird gelöscht …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting …"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siliniyor …"
          }
        }
      }
    },
    "profiles.icloudDelete.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht alles, was CineLounge in deiner iCloud gespeichert hat – Profile, Fortschritt, Favoriten, IPTV-Zugänge und Einstellungen – auf allen deinen Geräten. Profile, die dir jemand geteilt hat, bleiben. Auch auf diesem Gerät verschwinden deine Profile; beim nächsten Start richtet sich die App neu ein. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes everything CineLounge has stored in your iCloud – profiles, progress, favorites, IPTV accounts and settings – on all your devices. Profiles someone shared with you stay. Your profiles are removed from this device too; the app sets itself up again on next launch. This can't be undone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CineLounge'un iCloud'unda sakladığı her şeyi siler – profiller, ilerleme, favoriler, IPTV erişimleri ve ayarlar – tüm cihazlarında. Seninle paylaşılan profiller kalır. Profillerin bu cihazdan da kaldırılır; uygulama bir sonraki açılışta yeniden kurulur. Bu işlem geri alınamaz."
          }
        }
      }
