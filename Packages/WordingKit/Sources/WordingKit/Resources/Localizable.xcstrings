    "childLock.doorReason.spieler": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was zu sehen war, darf laufen — sonst wäre die Grenze eine Falle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What could be seen may play — otherwise the limit would be a trap."
