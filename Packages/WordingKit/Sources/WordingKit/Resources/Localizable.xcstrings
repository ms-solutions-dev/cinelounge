    "childLock.doorReason.senderlisteAendern": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer den Zugang ändert, ändert, welche Sender hereinkommen."
