      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier gehen Zugangsmarken, Kennwörter und die PIN dieser Sperre auf ein anderes Gerät hinaus, das diese Sperre nicht kennt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access tokens, passwords and the PIN of this lock leave from here for another device that does not know this lock."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişim belirteçleri, parolalar ve bu kilidin PIN’i buradan, bu kilidi tanımayan başka bir cihaza gider."
          }
        }
      }
    },
    "childLock.doorReason.uebergabeEmpfang": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier kommen Zugänge von einem anderen Gerät herein — samt einer Kindersicherung, die diese hier überschriebe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access details from another device arrive here — along with parental controls that would overwrite the ones here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir cihazdan erişim bilgileri buraya gelir — buradakinin üzerine yazacak bir ebeveyn denetimiyle birlikte."
          }
        }
      }
    },
    "childLock.doorReason.umzug": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Umzug schreibt die Serveradresse aller Konten um."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A move rewrites the server address of every account."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşıma, tüm hesapların sunucu adresini yeniden yazar."
          }
        }
      }
    },
    "childLock.doorReason.vorrat": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was geladen ist, wurde schon einmal freigegeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What has been downloaded was already allowed once."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilmiş olan şeye daha önce bir kez izin verilmiştir."
          }
        }
      }
    },
    "childLock.doorReason.wiedergabe": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Weg in die Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A way into the settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlara giden bir yol."
          }
        }
      }
    },
    "childLock.doorReason.wolke": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier geht ein ganzes Profil an ein fremdes Apple-Konto — mit Zugängen, Stand und der PIN dieser Sperre, und ohne dass beide Geräte im selben Haus stehen müssen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A whole profile goes to someone else’s Apple Account from here — with access details, progress and the PIN of this lock, and without both devices having to be in the same home."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada bütün bir profil başka birinin Apple Hesabı’na gider — erişim bilgileri, izleme durumu ve bu kilidin PIN’iyle birlikte, üstelik iki cihazın aynı evde olması gerekmeden."
          }
        }
      }
    },
    "childLock.doorReason.zertifikate": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertrauen in einen Server ist eine Sicherheitsfrage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trusting a server is a question of security."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sunucuya güvenmek bir güvenlik meselesidir."
          }
        }
      }
    },
    "childLock.doors": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was die PIN sperrt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the PIN locks"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN neyi kilitler"
          }
        }
      }
    },
    "childLock.forgot.ask": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anfrage senden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send request"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstek gönder"
          }
        }
      }
    },
    "childLock.forgot.askedBy %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantragt von %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requested by %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteyen: %@"
          }
        }
      }
    },
    "childLock.forgot.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt zwei Wege zurück. Der schnelle geht über ein anderes Gerät mit derselben Apple-ID; ohne ein solches bleibt das Zurücksetzen mit Frist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are two ways back. The quick one uses another device on the same Apple ID; without one, the timed reset remains."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri dönmenin iki yolu var. Hızlı olanı aynı Apple Kimliğine sahip başka bir cihazdan geçer; o yoksa süreli sıfırlama kalır."
          }
        }
      }
    },
    "childLock.forgot.noDevice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein anderes Gerät?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No other device?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka cihaz yok mu?"
          }
        }
      }
    },
    "childLock.forgot.otherDeviceHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Gerät mit derselben Apple-ID wird benachrichtigt. Wer dort bestätigt, hebt die Sperre hier sofort auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every device on the same Apple ID is notified. Confirming there lifts the lock here right away."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı Apple Kimliğindeki her cihaz bilgilendirilir. Orada onaylamak buradaki kilidi hemen kaldırır."
          }
        }
      }
    },
    "childLock.forgot.ready": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sperre darf fallen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lock may be lifted"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilit kaldırılabilir"
          }
        }
      }
    },
    "childLock.forgot.readyHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kindersicherung wird abgeschaltet und die PIN gelöscht. Eine neue lässt sich danach in den Einstellungen vergeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parental controls will be switched off and the PIN deleted. A new one can be set afterwards in Settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ebeveyn denetimi kapatılacak ve PIN silinecek. Yenisi daha sonra Ayarlar'dan belirlenebilir."
          }
        }
      }
    },
    "childLock.forgot.remaining": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remaining"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalan"
          }
        }
      }
    },
    "childLock.forgot.reset": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In 24 Stunden zurücksetzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset in 24 hours"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "24 saat içinde sıfırla"
          }
        }
      }
    },
    "childLock.forgot.resetConfirm": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurücksetzen in 24 Stunden?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset in 24 hours?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "24 saat içinde sıfırlansın mı?"
          }
        }
      }
    },
    "childLock.forgot.resetHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kindersicherung samt Gerätesperre fällt dann weg. Bis dahin lässt sich das jederzeit abbrechen — auch von einem anderen Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parental controls and the device lock will be removed. Until then this can be cancelled at any time, including from another device."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ebeveyn denetimi ve cihaz kilidi kaldırılacak. O zamana kadar istediğiniz an iptal edilebilir, başka bir cihazdan da."
          }
        }
      }
    },
    "childLock.forgot.running": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurücksetzen läuft"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset in progress"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıfırlama sürüyor"
          }
        }
      }
    },
    "childLock.forgot.runningHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach ist die Kindersicherung aus. Wer die PIN doch noch weiß, bricht hier ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After that, parental controls are off. If you do remember the PIN, cancel here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ardından ebeveyn denetimi kapanır. PIN'i hatırlıyorsanız buradan iptal edin."
          }
        }
      }
    },
    "childLock.forgot.unlock": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt zurücksetzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset now"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi sıfırla"
          }
        }
      }
    },
    "childLock.forgot.waitingServer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anfrage steht, aber dieses Gerät hat noch keine Verbindung zu iCloud. Die Frist fängt erst an zu laufen, wenn sie dort angekommen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request is queued, but this device has no iCloud connection yet. The countdown only starts once it has arrived there."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstek sırada, ancak bu cihazın henüz iCloud bağlantısı yok. Geri sayım ancak oraya ulaştığında başlar."
          }
        }
      }
    },
    "childLock.limit": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Altersgrenze"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Age limit"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaş sınırı"
          }
        }
      }
    },
    "childLock.limitNone": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ohne Grenze"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "no limit"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "sınır yok"
          }
        }
      }
    },
    "childLock.live": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live für Kinder"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live TV for children"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çocuklar için canlı yayın"
          }
        }
      }
    },
    "childLock.liveChannels %lld": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Sender"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "channels: %lld"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld kanal"
          }
        }
      }
    },
    "childLock.liveClear": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle abwählen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deselect all"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tümünün seçimini kaldır"
          }
        }
      }
    },
    "childLock.liveCount %lld %lld": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruppen: %1$lld · Sender: %2$lld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Groups: %1$lld · channels: %2$lld"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grup: %1$lld · kanal: %2$lld"
          }
        }
      }
    },
    "childLock.liveGone": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "nicht mehr beim Anbieter"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "no longer offered"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "sağlayıcıda artık yok"
          }
        }
      }
    },
    "childLock.liveGroupCount %lld": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruppen: %lld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Groups: %lld"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grup: %lld"
          }
        }
      }
    },
    "childLock.liveHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender tragen keine Altersangaben. Ein Kind sieht Live nur mit den Gruppen, die hier für es gewählt sind — neue Gruppen des Anbieters kommen nie von selbst dazu, Erwachsenensender nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Channels carry no age ratings. A child only sees Live TV with the groups chosen for them here — new groups from the provider are never added on their own, adult channels never."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanalların yaş sınırı yoktur. Çocuk canlı yayını yalnızca burada kendisi için seçilen gruplarla görür — sağlayıcının yeni grupları asla kendiliğinden eklenmez, yetişkin kanalları asla."
          }
        }
      }
    },
    "childLock.liveListHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur angekreuzte Gruppen erscheinen für dieses Kind. Die Zahl nennt die Sender ohne Erwachsenensender."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only ticked groups appear for this child. The number counts channels without adult channels."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu çocuk için yalnızca işaretli gruplar görünür. Sayı, yetişkin kanalları hariç kanalları gösterir."
          }
        }
      }
    },
    "childLock.liveNoChildren": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Kinderprofil — lege eines unter „Wer schaut?“ → „Profil anlegen“ an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No child profile yet — create one under “Who’s watching?” → “Add profile”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz çocuk profili yok — “Kim izliyor?” → “Profil ekle” altında oluştur."
          }
        }
      }
    },
    "childLock.liveNoStock": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Sender geladen. Richte unter „IPTV“ einen Zugang ein oder öffne einmal „Live“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No channels loaded yet. Set up an account under “IPTV” or open “Live” once."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz kanal yüklenmedi. “IPTV” altında bir erişim kur ya da bir kez “Canlı” aç."
          }
        }
      }
    },
    "childLock.liveOff": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Live"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Live TV"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı yayın yok"
          }
        }
      }
    },
    "childLock.ratingsKnown": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstanden"
