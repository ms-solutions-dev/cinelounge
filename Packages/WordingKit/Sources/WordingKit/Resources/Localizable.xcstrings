    },
    "childLock.doorReason.kontoNeu": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neues Konto hätte keine Grenze."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new account would have no limit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir hesabın hiçbir sınırı olmazdı."
          }
        }
      }
    },
    "childLock.doorReason.kontowechsel": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Profilwechsel hebt jede Grenze auf — sonst wäre die ganze Sperre einen Handgriff weit weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching profiles lifts every limit — otherwise the whole lock would be one step away."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil değiştirmek her sınırı kaldırır — yoksa bütün kilit tek adım uzakta olurdu."
          }
