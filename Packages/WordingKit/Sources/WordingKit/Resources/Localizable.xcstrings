    "setup.jellyfin.unreachable": {
      "comment": "Setup A5: the Jellyfin server from the profile does not answer",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server aus deinem Profil antwortet nicht. Vielleicht ist er umgezogen, oder dieses Gerät ist in einem anderen Netz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server from your profile does not answer. It may have moved, or this device is on a different network."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilindeki sunucu yanıt vermiyor. Taşınmış olabilir ya da bu cihaz başka bir ağda."
          }
        }
      }
    },
    "setup.notice.later": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Nein lässt sich später nur in den Systemeinstellungen zurücknehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A “no” can afterwards only be undone in the system settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir “hayır” sonradan yalnızca sistem ayarlarından geri alınabilir."
          }
        }
      }
    },
    "setup.notice.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So findet die App Jellyfin und den CL-Server von selbst. tvOS fragt gleich einmal nach – bitte „Erlauben“ wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That way the app finds Jellyfin and the CL-Server by itself. tvOS will ask once in a moment – please choose “Allow”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Böylece uygulama Jellyfin’i ve CL-Server’ı kendisi bulur. tvOS birazdan bir kez soracak – lütfen “İzin Ver”i seç."
          }
        }
      }
    },
    "setup.notice.title": {
      "comment": "Setup: the notice before the first home-network search",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Darf CineLounge im Heimnetz suchen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May CineLounge search your home network?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CineLounge ev ağında arama yapabilir mi?"
          }
        }
      }
    },
    "setup.pin.head %@": {
      "comment": "Setup A3K: head with the child profile's name",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
