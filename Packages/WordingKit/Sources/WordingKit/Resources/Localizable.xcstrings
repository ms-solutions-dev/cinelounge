        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arama yalnızca bu hesabın görebileceği şeyleri bulur."
          }
        }
      }
    },
    "childLock.doorReason.ueber": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fassung, Datenschutz und Lizenzen müssen leicht erreichbar sein."
