          "stringUnit": {
            "state": "translated",
            "value": "Hier werden Konten angelegt, entfernt und gewechselt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is where accounts are added, removed and switched."
