          "stringUnit": {
            "state": "translated",
            "value": "Der Ausweg für den Elternteil, der seine PIN vergessen hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The way out for a parent who has forgotten their PIN."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
