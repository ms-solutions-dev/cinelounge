        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesaplar burada eklenir, kaldırılır ve değiştirilir."
          }
        }
      }
    },
    "childLock.doorReason.kontoEinstellungen": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Weg zu Konten, Speicher und Zertifikaten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The way to accounts, storage and certificates."
