    "childLock.adult.hideUnmarked.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "gilt für alle Sender aus M3U-Listen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "applies to every channel from an M3U list"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "M3U listelerinden gelen tüm kanallar için geçerli"
          }
        }
      }
    },
    "childLock.adult.show": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erwachsenensender anzeigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
