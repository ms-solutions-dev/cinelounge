    "player.stillstandLeitungKnappHint %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es kommen %@ Mbit/s an, der Film braucht gerade %@ Mbit/s. Kurze Pausen zum Nachladen sind möglich – das ist der Anbieter, kein Fehler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Mbit/s are coming in, the film currently needs %@ Mbit/s. Short pauses to reload are possible – that is the provider, not an error."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Mbit/s geliyor, film şu anda %@ Mbit/s istiyor. Yeniden yükleme için kısa duraklamalar olabilir; bu sağlayıcıdan kaynaklanıyor, bir hata değil."
          }
        }
      }
    },
    "player.stillstandMotor": {
      "extractionState": "manual",
      "localizations": {
