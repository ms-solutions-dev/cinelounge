        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten oynayanı yönetir."
          }
        }
      }
    },
    "childLock.doorReason.freigaben": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer Freigaben zuordnet, verschiebt die Grenze."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assigning age ratings moves the limit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaş derecelendirmesi atayan, sınırı kaydırır."
          }
        }
      }
    },
    "childLock.doorReason.gruppen": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeblendete Sendergruppen lassen sich hier zurückholen."
