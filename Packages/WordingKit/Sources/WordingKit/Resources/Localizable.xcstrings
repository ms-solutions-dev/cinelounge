    "childLock.doorReason.abmelden": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abmelden nimmt die Grenze mit dem Konto weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing out takes the limit away together with the account."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıkış yapmak sınırı hesapla birlikte kaldırır."
          }
        }
      }
    },
    "childLock.doorReason.andereGeraete": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von hier aus gehen Profile, Zugänge und der Kinderschutz an ein anderes Gerät — das entscheidet ein Erwachsener."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From here, profiles, access details and child protection go to another device — an adult decides that."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buradan profiller, erişim bilgileri ve çocuk koruması başka bir cihaza gider — buna bir yetişkin karar verir."
          }
        }
      }
    },
    "childLock.doorReason.bewertungenEinstellungen": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Weg in die Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A way into the settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlara giden bir yol."
          }
        }
      }
    },
    "childLock.doorReason.bibliothek": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Grenze liegt am Titel, nicht am Bildschirm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The limit sits on the title, not on the screen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınır ekranda değil, başlıktadır."
          }
        }
      }
    },
