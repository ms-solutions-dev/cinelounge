    "childLock.doorReason.kindersicherung": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier wird die Sperre eingestellt, der Erwachsenenschalter gestellt — und die Sperre ausgeschaltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is where the lock is set up and the adult switch is set — and where the lock is turned off."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilit burada ayarlanır, yetişkin anahtarı burada belirlenir — ve kilit burada kapatılır."
          }
        }
      }
    },
    "childLock.doorReason.konten": {
      "extractionState": "manual",
      "localizations": {
