    "settings.portals.joinWaiting": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet auf Freigabe. Sobald der Verwalter entscheidet, geht es hier weiter — solange dieser Bildschirm offen ist, wird alle 15 Sekunden nachgefragt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for approval. As soon as the administrator decides, it continues here — while this screen is open, it checks every 15 seconds."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onay bekleniyor. Yönetici karar verir vermez burada devam eder — bu ekran açık olduğu sürece her 15 saniyede bir sorulur."
          }
        }
      }
    },
