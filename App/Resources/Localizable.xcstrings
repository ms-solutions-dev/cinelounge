    "settings.topShelfHint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was der obere Bereich des Apple-TV-Startbildschirms zeigt, wenn CineLounge in der obersten Reihe liegt. Die Auswahl greift beim nächsten Besuch des Startbildschirms."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the top area of the Apple TV Home Screen shows while CineLounge sits in the top row. The choice takes effect the next time the Home Screen appears."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CineLounge en üst sırada olduğunda Apple TV giriş ekranının üst bölümünde ne gösterileceği. Seçim, giriş ekranına bir sonraki geçişte etkinleşir."
          }
        }
      }
    },
