    "settings.profilesHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer an diesem Fernseher schaut — anlegen, wechseln, ändern. Jedes Profil hat seine eigene Startseite, seine IPTV-Zugänge und seinen Stand."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who watches on this TV — add, switch, edit. Every profile has its own home screen, IPTV accounts and progress."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu televizyonda kim izliyor — ekle, değiştir, düzenle. Her profilin kendi başlangıç ekranı, IPTV erişimleri ve izleme durumu vardır."
          }
        }
      }
    },
    "settings.ratingsKey": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewertungen von IMDb, Rotten Tomatoes und Metacritic"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ratings from IMDb, Rotten Tomatoes and Metacritic"
