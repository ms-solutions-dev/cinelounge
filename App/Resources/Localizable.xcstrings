        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lässt sich nicht abspielen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will not play"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oynatılamıyor"
          }
        }
      }
    },
    "player.stalled": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es kommt nichts an"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is coming through"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey gelmiyor"
          }
        }
      }
    },
    "player.stalledContainer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Format kann das Gerät nicht direkt öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device cannot open this format directly"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihaz bu formatı doğrudan açamıyor"
          }
        }
      }
    },
    "player.stalledContainerHint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Film liegt in einem Behälter, den der Systemplayer nicht liest — und das Umpacken ist fehlgeschlagen. Ein zweiter Versuch ändert daran nichts; die Ursache steht in der Diagnose."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The film is in a container the system player cannot read, and remuxing failed. Trying again won't change that; the cause is in the diagnostics."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Film, sistem oynatıcısının okuyamadığı bir kapsayıcıda ve yeniden paketleme başarısız oldu. Yeniden denemek bunu değiştirmez; nedeni tanılamada."
          }
        }
      }
    },
    "player.stalledHint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiedergabe steht, ohne dass ein Fehler gemeldet wurde. Möglich: Der Server liefert nicht, oder die Datei lässt sich ab dieser Stelle nicht lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The playback has stopped without an error. The server may not be delivering, or the file cannot be read from this point."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oynatma bir hata bildirilmeden durdu. Sunucu veri göndermiyor olabilir veya dosya bu noktadan itibaren okunamıyor."
          }
        }
      }
    },
    "player.stalledLive": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sender liefert nichts"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The channel is not delivering"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal yayın vermiyor"
          }
        }
      }
    },
    "player.stalledLiveHint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter sendet kein Bild. Möglich: Der Sender gehört nicht zum Paket, oder die eine erlaubte Verbindung ist noch anderweitig belegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider is sending no picture. The channel may not be part of your package, or the single permitted connection is still in use elsewhere."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcı görüntü göndermiyor. Kanal paketinizde olmayabilir veya izin verilen tek bağlantı başka yerde kullanılıyor olabilir."
          }
        }
      }
    },
    "player.subtitlePreparing": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Untertitel wird vorbereitet … Jellyfin liest ihn aus der Datei, bei großen Dateien dauert das einmalig einige Minuten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing subtitles … Jellyfin reads them from the file; for large files this takes a few minutes, once."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altyazı hazırlanıyor … Jellyfin altyazıyı dosyadan okuyor, büyük dosyalarda bu bir kez birkaç dakika sürer."
          }
        }
      }
    },
    "player.subtitleUnavailable": {
      "localizations": {
