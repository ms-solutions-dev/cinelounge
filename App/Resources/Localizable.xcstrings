    "childLock.serverDisabled": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server führt dieses Konto als abgeschaltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server lists this account as disabled."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu bu hesabı devre dışı olarak listeliyor."
          }
        }
      }
    },
    "childLock.serverHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgelesen und angezeigt, nicht befolgt. Jellyfin filtert ohnehin — und zuverlässiger, denn es gibt gesperrte Titel gar nicht erst heraus. Es weiß dafür nichts von IPTV, dem CL-Server und diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read and shown, not obeyed. Jellyfin filters anyway — and more reliably, because it never hands out blocked titles. It knows nothing about IPTV, the CL server or this device."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okunur ve gösterilir, uygulanmaz. Jellyfin zaten filtreler ve daha güvenilir yapar: engelli içerikleri hiç vermez. Buna karşılık IPTV’den, CL-Server’dan ve bu cihazdan haberi yoktur."
          }
        }
      }
    },
    "childLock.serverLimit %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server erlaubt diesem Konto höchstens Stufe %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server allows this account up to level %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu bu hesaba en fazla %@ seviyesine izin veriyor."
          }
        }
      }
    },
    "childLock.serverNone": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server führt für dieses Konto keine Grenze."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server sets no limit for this account."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu bu hesap için sınır tanımlamıyor."
          }
        }
      }
    },
    "childLock.tabs": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seitenleiste bei Gerätesperre"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidebar with the device lock"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz kilidinde kenar çubuğu"
          }
        }
      }
    },
    "childLock.tabs.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gesperrter Eintrag verschwindet, er wird nicht abgeblendet. Für Sender, Sport, Anbieterkatalog und den CL-Server gibt es keine Freigaben — es gibt dort nichts, woran eine Grenze liegen könnte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A locked entry disappears, it is not dimmed. Channels, sport, the provider catalogue and the CL server carry no ratings — there is nothing there for a limit to hold on to."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilitli bir öğe kaybolur, soluklaştırılmaz. Kanallarda, sporda, sağlayıcı kataloğunda ve CL-Server’da derece yoktur — orada bir sınırın tutunabileceği hiçbir şey yok."
          }
        }
      }
    },
    "childLock.unknown": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unverstandene Angaben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ratings we cannot read"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okunamayan yaş bilgileri"
          }
        }
      }
    },
    "childLock.unknownHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche Titel tragen eine Altersangabe, die diese App nicht einordnen kann. Ein Titel ganz ohne Angabe ist etwas anderes — der kommt immer durch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some titles carry an age rating this app cannot interpret. A title with no rating at all is a different case — it always comes through."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı içerikler bu uygulamanın çözemediği bir yaş bilgisi taşır. Hiç bilgisi olmayan içerik farklıdır; o her zaman görünür."
          }
        }
      }
    },
    "childLock.unknownToggle": {
      "extractionState": "manual",
