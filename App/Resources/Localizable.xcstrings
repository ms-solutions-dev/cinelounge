    "settings.subtitleStyleHint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für Textuntertitel des Systemmotors. Zeichensatz-Untertitel (ASS) behalten ihr eigenes Schriftbild — bei Anime ist das Absicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to text subtitles of the system player. Styled subtitles (ASS) keep their own look — for anime that is intentional."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem oynatıcısının metin altyazıları için geçerlidir. Biçimli altyazılar (ASS) kendi görünümünü korur — anime için bu kasıtlıdır."
          }
        }
      }
    },
    "settings.subtitlesHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für die Person, die gerade schaut, und wandert mit ihrem Profil auf jedes Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to whoever is watching and travels with their profile to every device."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda izleyen kişi için geçerlidir ve profiliyle birlikte her cihaza taşınır."
          }
        }
      }
    },
    "settings.syncDone": {
