    "settings.syncNow": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt abgleichen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync now"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi eşitle"
          }
        }
      }
    },
    "settings.syncNowHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Jetzt abgleichen“ verwirft die gemerkten Listen und holt den Bestand sofort neu vom Server — für Titel, die gerade erst eingespielt wurden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Sync now” discards the remembered lists and refetches the catalogue from the server right away — for titles that were just added."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Şimdi eşitle\" kaydedilen listeleri atar ve içeriği hemen sunucudan yeniden çeker — yeni eklenen yapımlar için."
          }
        }
      }
    },
    "settings.themeHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für die ganze App. Der Wechsel baut die Oberfläche einmal neu auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to the whole app. Switching rebuilds the interface once."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm uygulama için geçerlidir. Değiştirmek arayüzü bir kez yeniden oluşturur."
          }
        }
      }
    },
    "settings.topShelf": {
