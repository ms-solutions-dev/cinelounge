    "settings.filmographyKeyHint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Laufbahn eines Darstellers: Ein Druck auf ein Gesicht in der Besetzung zeigt, wo er sonst noch mitgespielt hat. Der Zugang ist bei themoviedb.org kostenlos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For an actor’s career: pressing a face in the cast shows everything else they appeared in. The key is free at themoviedb.org."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir oyuncunun kariyeri için: oyuncu kadrosunda bir yüze basınca başka nerelerde oynadığı görünür. Anahtar themoviedb.org adresinde ücretsizdir."
          }
        }
      }
    },
