    "settings.liveAdultCount %lld %lld %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In deinen Listen so gekennzeichnet: %1$lld von %2$lld Sendern — in den Gruppen %3$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marked this way in your lists: %1$lld of %2$lld channels — in the groups %3$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listeleriniz: %2$lld kanaldan %1$lld tanesi bu şekilde işaretli — %3$@ gruplarında."
          }
        }
      }
    },
    "settings.liveAdultHint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorgabe: ausgeblendet. Gezählt wird, was deine Listen als Erwachsenensender kennzeichnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden by default. Counted from what your lists mark as adult channels."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan: gizli. Listelerinizin yetişkin kanalı olarak işaretlediği kanallar sayılır."
          }
        }
      }
    },
    "settings.liveAdultMoved": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schalter für Erwachsenensender steht unter „Kindersicherung“ — hinter der PIN."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The adult channels switch lives under “Parental controls” — behind the PIN."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yetişkin kanalları anahtarı “Ebeveyn denetimi” altında — PIN’in arkasında."
          }
        }
      }
    },
    "settings.liveAdultNone %lld": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Deine Listen: Der eine Sender darin ist nicht so gekennzeichnet — der Schalter ändert darum nichts."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Deine Listen: keiner von %lld Sendern ist so gekennzeichnet — der Schalter ändert darum nichts."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Your lists: the one channel in them carries no such marking — so the switch changes nothing."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Your lists: none of %lld channels carries this marking — so the switch changes nothing."
                }
              }
            }
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listeleriniz: %lld kanaldan hiçbiri bu şekilde işaretli değil — bu yüzden anahtar bir şey değiştirmez."
          }
        }
      }
    },
    "settings.liveAdultOpen": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Kindersicherung öffnen"
          }
