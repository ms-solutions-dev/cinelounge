        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Motor dosyayı açamadı. Sunucu kapalı olabilir, dosya eksik olabilir veya biçim bu cihazda desteklenmiyor olabilir."
          }
        }
      }
