    "settings.audioLanguageHint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt beim Start eines Titels. Führt die Datei die Sprache nicht, bleibt es bei ihrer Standardspur — im Player lässt sich jederzeit umschalten."
          }
