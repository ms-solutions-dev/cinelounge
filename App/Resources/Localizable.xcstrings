        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik altyazı"
          }
        }
      }
    },
    "settings.subtitleMode.off": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
