    "pairing.getAction": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Code zeigen und warten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show code and wait"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodu göster ve bekle"
          }
