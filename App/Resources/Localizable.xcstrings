    "settings.ownDecoderHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur zur Fehlersuche im Direktrenderer. Das Apple TV entflechtet nicht in Hardware; der Weg wird für die GPU-Entflechtung gebraucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Troubleshooting only, direct renderer. The Apple TV does not deinterlace in hardware; this path is needed for GPU deinterlacing."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca doğrudan oynatıcıda sorun aramak için. Apple TV donanımda ayrıştırmaz; bu yol GPU ayrıştırması için gerekli."
          }
        }
      }
    },
    "settings.plainSubtitles": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichensatz-Untertitel"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Styled Subtitles"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biçimli Altyazılar"
          }
        }
      }
    },
    "settings.plainSubtitlesHint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ASS-Untertitel (häufig bei Anime) bringen ihr eigenes Schriftbild mit — Positionen, Farben, Karaoke. Darstellen kann das nur der zweite Motor. Wer stattdessen schlichten Text im Schriftbild des Systems vorzieht, bekommt dafür Bild-in-Bild und die Bildwiederholrate des Fernsehers zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ASS subtitles (common in anime) carry their own styling — positions, colours, karaoke. Only the second engine can draw that. Choosing plain text in the system's styling instead gives you picture-in-picture and display refresh-rate matching back."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ASS altyazıları (animelerde yaygın) kendi biçimini taşır — konum, renk, karaoke. Bunu yalnızca ikinci motor çizebilir. Bunun yerine sistemin biçiminde düz metni seçerseniz, resim içinde resim ve ekran yenileme hızı eşlemesi geri gelir."
          }
        }
      }
    },
