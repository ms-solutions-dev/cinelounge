    "settings.homeCategoriesHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Kategorien ein eigenes Regal bekommen. Ohne Wahl die ersten — und die sind beim Anbieter meist Serien. Die Reihenfolge stellst du unter „Zeilen auf der Startseite“ ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which categories get their own shelf. Without a choice, the first ones — and with this provider those are usually series. The order is set under “Rows on the home screen”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangi kategorilerin kendi rafı olacağı. Seçim yapılmazsa ilk sıradakiler — ve bu sağlayıcıda onlar genelde dizilerdir. Sıralamayı „Başlangıç ekranındaki satırlar“ altında ayarlarsın."
          }
        }
      }
    },
    "settings.homeChannelsHint2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links die Gruppe, rechts ihre Sender. Ohne Wahl die zuletzt gesehenen, die gerade etwas zeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The group on the left, its channels on the right. Without a choice, the most recently watched ones that are showing something."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Solda grup, sağda kanalları. Seçim yapılmazsa o anda bir şey gösteren en son izlenenler."
          }
        }
      }
    },
