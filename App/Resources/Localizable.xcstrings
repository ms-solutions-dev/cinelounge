        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Informationsspalte tritt der Trailer nach drei Sekunden an die Stelle des Plakats. Über eine schmale Leitung besser aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the info column the trailer replaces the poster after three seconds. Better off on a slow connection."
