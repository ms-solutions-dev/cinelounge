    "state.review.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Zustand, den die App zeigen kann — ohne dass er eintreten muss. Zum Nachsehen am Gerät: Für Fokus und Tastendrücke zählt nur, was hier wirklich zu sehen war."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every state the app can show, without having to make it happen. For checking on the device: for focus and button presses, only what was actually seen here counts."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın gösterebileceği her durum — gerçekleşmesine gerek kalmadan. Cihazda denetlemek için: odak ve tuş basışlarında yalnızca burada gerçekten görülen sayılır."
          }
        }
      }
    },
