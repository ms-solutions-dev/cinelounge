    "accounts.moveDone %lld": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Adresse übernommen — %lld Konto umgezogen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Adresse übernommen — %lld Konten umgezogen."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Address updated — %lld account moved."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Address updated — %lld accounts moved."
                }
              }
            }
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres güncellendi — %lld hesap taşındı."
          }
        }
      }
    },
    "accounts.moveExplain": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dein Jellyfin unter einer neuen Adresse läuft, wird sie hier eingetragen. Die Anmeldung bleibt bestehen — nichts muss neu eingerichtet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your Jellyfin runs at a new address, enter it here. Your sign-in stays — nothing has to be set up again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin’in yeni bir adreste çalışıyorsa buraya gir. Oturumun korunur; hiçbir şeyi yeniden kurman gerekmez."
          }
        }
      }
    },
    "accounts.moveFrom": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisher"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previously"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki"
          }
        }
      }
    },
    "accounts.moveOtherServer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dort antwortet ein anderer Server. Ein zweiter Server wird über „Weiteres Konto“ eingerichtet — ein Umzug würde dem bisherigen seine Adresse nehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A different server answers there. Set up a second server with “Add account” — moving would take the address away from the existing one."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orada başka bir sunucu yanıt veriyor. İkinci sunucuyu “Hesap ekle” ile kur; taşımak mevcut sunucunun adresini alır."
          }
        }
      }
    },
    "accounts.moveSameServer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derselbe Server antwortet unter der neuen Adresse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same server answers at the new address."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı sunucu yeni adreste yanıt veriyor."
          }
        }
      }
    },
    "accounts.moveUnverified": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dort antwortet ein Server. Ob es derselbe ist, lässt sich bei diesem Zugang nicht prüfen — er stammt aus einer älteren Fassung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A server answers there. Whether it is the same one cannot be checked for this account — it comes from an older version."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orada bir sunucu yanıt veriyor. Aynısı olup olmadığı bu hesap için denetlenemiyor; eski bir sürümden geliyor."
          }
        }
      }
    },
    "accounts.newNoPinYet": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist noch keine PIN gesetzt — bis dahin ist ein Kinderkonto eine Auskunft und keine Sperre. Die PIN steht unter Einstellungen → Kindersicherung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No PIN is set yet — until then a child account is a label, not a lock. Set the PIN under Settings → Parental controls."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz PIN tanımlı değil; o zamana kadar çocuk hesabı bir etikettir, kilit değil. PIN: Ayarlar → Ebeveyn denetimi."
          }
        }
      }
    },
    "cache.clearHint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts davon geht verloren: Sender, Listen und Bilder kommen beim nächsten Öffnen wieder — es dauert dann einmal länger. Die Diagnose-Spuren bleiben stehen, weil sie sich nicht wiederherstellen lassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is lost: channels, lists and images return the next time you open them — it just takes longer once. Diagnostic traces are kept, because they cannot be restored."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey kaybolmaz: kanallar, listeler ve görseller bir sonraki açılışta geri gelir — yalnızca bir kez daha uzun sürer. Tanılama kayıtları geri getirilemediği için korunur."
          }
        }
      }
    },
    "cache.clearNow": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischenspeicher aufräumen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear cache"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önbelleği temizle"
          }
        }
      }
    },
    "cache.cleared": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "wird aufgeräumt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cleared"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "temizlenir"
          }
        }
      }
    },
    "cache.kept": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "bleibt stehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "kept"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "korunur"
          }
        }
      }
    },
