          }
        }
      }
    },
    "settings.subtitleModeHint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erzwungene Untertitel übersetzen nur, was auch im Originalton niemand versteht — fremde Sprachen, Schilder, die Zeichensprache der Affen. Die Vollspur schreibt dagegen jedes Wort mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forced subtitles only translate what nobody understands in the original audio either — foreign languages, signs, the apes' sign language. A full track writes out every word instead."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorunlu altyazılar yalnızca orijinal seste de kimsenin anlamadığı yerleri çevirir — yabancı diller, tabelalar, maymunların işaret dili. Tam altyazı ise her sözcüğü yazar."
          }
        }
      }
    },
    "settings.subtitlePreview": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So sehen Untertitel im Film aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is how subtitles will look."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altyazılar filmde böyle görünecek."
          }
        }
