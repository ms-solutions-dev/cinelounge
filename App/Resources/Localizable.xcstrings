    "settings.section.devices": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Geräte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other devices"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer cihazlar"
          }
        }
      }
    },
    "settings.devicesHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was dieses Gerät mit einem zweiten verbindet: ein Profil teilen, die Übergabe vom Handy, das iPhone als Fernbedienung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What connects this device to another one: sharing a profile, the handover from a phone, the iPhone as a remote."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazı bir başkasına bağlayanlar: profil paylaşma, telefondan aktarım, kumanda olarak iPhone."
          }
        }
      }
    },
    "settings.devices.pairingHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt das aktive Profil über iCloud an ein anderes Gerät weiter oder holt eines von dort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gives the active profile to another device via iCloud, or fetches one from there."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin profili iCloud üzerinden başka bir cihaza verir ya da oradan bir profil alır."
          }
        }
      }
    },
    "settings.devices.handoverHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übernimmt Zugänge und Kinderschutz vom Handy über das Heimnetz — ohne iCloud."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Takes over sources and child protection from a phone over the home network — without iCloud."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynakları ve çocuk korumasını ev ağı üzerinden telefondan alır — iCloud olmadan."
          }
        }
      }
    },
    "settings.devices.remoteHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt einen Code, den du mit der iPhone-Kamera scannst. Danach bedient das iPhone diesen Fernseher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows a code you scan with the iPhone camera. The iPhone then controls this TV."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone kamerasıyla tarayacağın bir kod gösterir. Ardından iPhone bu televizyonu kumanda eder."
          }
        }
      }
    }
  },
  "version": "1.0"
}
