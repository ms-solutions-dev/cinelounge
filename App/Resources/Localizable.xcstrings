    "login.playlistBadAddress": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Adresse konnte nicht gelesen werden. Erwartet wird nur der Server, etwa http://beispiel.tv — nicht die vollständige Senderadresse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That address could not be read. Only the server is expected, e.g. http://example.tv — not the full stream address."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adres okunamadı. Yalnızca sunucu bekleniyor, örneğin http://ornek.tv — akışın tam adresi değil."
          }
        }
      }
    },
    "login.playlistCheck": {
