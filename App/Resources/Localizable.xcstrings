    "remote.pair.text": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne den Code in CineLounge auf dem iPhone. Danach steuert es diesen Fernseher und tippt auch Kennwörter — verschlüsselt, und nur dieses Telefon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the code in CineLounge on your iPhone. It can then control this TV and type passwords too — encrypted, and only this phone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodu iPhone'daki CineLounge ile tarayın. Ardından bu televizyonu yönetir ve şifre de yazabilir — şifreli ve yalnızca bu telefon."
          }
        }
      }
    },
