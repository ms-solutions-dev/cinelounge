    "vod.noSources": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Filme und Serien gefunden. Sie kommen aus deinen IPTV-Zugängen und aus Jellyfin — beides steht in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No films and series found yet. They come from your IPTV accounts and from Jellyfin — both are in Settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz film ve dizi bulunamadı. Bunlar IPTV erişimlerinden ve Jellyfin’den gelir — ikisi de Ayarlar'da."
          }
        }
      }
    },
