    "player.channelFailedHint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das kommt vom Anbieter und nicht aus der App: Die Leitung war zu langsam, oder der Sender ist ausgefallen. Ein zweiter Versuch lohnt sich meist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This comes from the provider, not the app: the line was too slow, or the channel went down. A second try usually works."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulamadan değil sağlayıcıdan kaynaklanır: bağlantı çok yavaştı ya da kanal düştü. İkinci deneme genelde işe yarar."
          }
        }
      }
    },
    "player.failed": {
