    "settings.shelfOrderHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reihenfolge und Sichtbarkeit. Voreingestellt ist: Weiterschauen zuerst, dann Serien, Filme, und Heimvideos zuletzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Order and visibility. Continue watching comes first by default, then series, films and home videos last."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıra ve görünürlük. Varsayılan: önce izlemeye devam, sonra diziler, filmler, en son ev videoları."
          }
        }
      }
    },
    "settings.signOutConfirm": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wirklich abmelden? Serveradresse, Name und Kennwort müssen danach neu eingegeben werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out? You will have to enter the server address, name and password again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıkış yapılsın mı? Sunucu adresi, ad ve parolanın yeniden girilmesi gerekir."
          }
        }
      }
    },
    "settings.account.none": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Jellyfin angemeldet. Mit einem Zugang siehst du Filme, Serien und Heimvideos aus deinem Jellyfin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Jellyfin signed in. With an account you see films, series and home videos from your Jellyfin."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum açılmış Jellyfin yok. Bir hesapla Jellyfin'indeki filmleri, dizileri ve ev videolarını görürsün."
          }
        }
      }
    },
    "settings.signOutHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Abmelden wird die Zugangsmarke verworfen. Hinterlegte IPTV-Zugänge bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing out discards the access token. IPTV accounts you added stay."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıkışta erişim anahtarı silinir. Eklenen IPTV erişimleri kalır."
          }
        }
      }
    },
    "settings.sportFiltersHint": {
      "localizations": {
