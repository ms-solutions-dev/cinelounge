    "sport.noGuide": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Programmzeitschrift ist noch nicht geholt — einmal abgleichen (Seitenleiste), dann füllt sich der Spielplan."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The programme guide hasn't been fetched yet — sync once (sidebar) and the schedule fills up."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Program rehberi henüz alınmadı — bir kez eşitleyin (kenar çubuğu), program dolacaktır."
          }
        }
      }
    },
    "sport.noSport": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeitschrift hält Sendungen für dieses Fenster, aber keinen Live-Sport darunter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The guide holds programmes for this window, but no live sport among them."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rehberde bu aralık için program var, ancak aralarında canlı spor yok."
          }
        }
      }
    },
    "sport.noWindow": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die nächsten 24 Stunden hält die Zeitschrift keine Sendungen. Anbieter reichen meist etwa einen Tag voraus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The guide holds no programmes for the next 24 hours. Providers usually reach about a day ahead."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayın rehberinde önümüzdeki 24 saat için program yok. Sağlayıcılar genelde yaklaşık bir gün ilerisini verir."
          }
        }
      }
    },
