    "settings.ratingsKeyHint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freiwillig. Einen kostenlosen Zugang gibt es bei omdbapi.com — 1000 Abfragen am Tag. Ohne ihn läuft alles, es fehlen nur diese Bewertungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Get a free key at omdbapi.com — 1000 lookups per day. Without it everything works, only these ratings are missing."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı. omdbapi.com adresinden ücretsiz bir anahtar alın — günde 1000 sorgu. Onsuz her şey çalışır, yalnızca bu puanlar eksik olur."
          }
        }
      }
    },
