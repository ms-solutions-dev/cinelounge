    "cert.changed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ACHTUNG: Bisher war ein anderes Zertifikat hinterlegt —"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WARNING: a different certificate was stored before —"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DİKKAT: Daha önce farklı bir sertifika kayıtlıydı —"
          }
        }
      }
    },
    "cert.explain": {
      "comment": "Erklärt, wozu der Fingerabdruck dient — sonst bestätigt man blind",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche den Fingerabdruck unten mit dem, der auf deinem Server steht. Stimmen sie überein, ist die Verbindung echt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare the fingerprint below with the one shown on your server. If they match, the connection is genuine."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağıdaki parmak izini sunucunuzda görünenle karşılaştırın. Aynıysa bağlantı gerçektir."
          }
        }
      }
    },
    "cert.title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Server bestätigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm this server"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sunucuyu onaylayın"
          }
        }
      }
    },
    "childLock.adultHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schalter steht hier und nicht unter Live: Hinter einer Tür, die er selbst betrifft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This switch lives here and not under Live: behind a door it is itself subject to."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu anahtar Canlı altında değil burada: kendisinin de tabi olduğu bir kapının arkasında."
          }
        }
      }
    },
    "childLock.blockedExplain": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Titel liegt über der eingestellten Altersgrenze. Wer ihn sehen will, schaltet die Kindersicherung in den Einstellungen ab — hier gibt es keinen Weg daran vorbei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This title is above the age limit that is set. To watch it, turn parental controls off in Settings — there is no way past it here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu içerik ayarlanan yaş sınırının üzerinde. İzlemek için Ayarlar’dan ebeveyn denetimini kapat; burada bir geçiş yolu yok."
          }
        }
      }
    },
    "childLock.blockedTitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Profil gesperrt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocked for this profile"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu profil için engelli"
          }
        }
      }
    },
    "childLock.curtain.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Bereich ist gesperrt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This section is locked"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bölüm kilitli"
          }
        }
      }
    },
    "childLock.deviceMode": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät sperren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock this device"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazı kilitle"
          }
        }
      }
    },
    "childLock.deviceModeHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für das Gerät, gleich wer angemeldet ist — für einen Fernseher im Kinderzimmer. Ein Kinderkonto bringt seine Grenze dagegen überall mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to the device no matter who is signed in — for a TV in a child’s room. A child account brings its limit everywhere instead."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimin oturum açtığından bağımsız olarak cihaza uygulanır — çocuk odasındaki bir TV için. Çocuk hesabı ise sınırını her yere taşır."
          }
        }
      }
    },
    "childLock.doors.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was die PIN nicht sperrt: das Gerät selbst und jede andere App. Sie ist eine Grenze in CineLounge, kein Jugendschutz für das Gerät — dafür sind die Einschränkungen in den Einstellungen des Apple TV da."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the PIN does not lock: the device itself and every other app. It is a boundary inside CineLounge, not device-wide parental control — that is what the Restrictions in the Apple TV settings are for."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN’in kilitlemediği şeyler: cihazın kendisi ve diğer tüm uygulamalar. O, CineLounge içinde bir sınırdır, cihaz genelinde bir koruma değil — bunun için Apple TV ayarlarındaki Kısıtlamalar var."
          }
        }
      }
    },
    "childLock.forgot.noDeviceHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dann wird die Kindersicherung nach 24 Stunden zurückgesetzt. Der Fernseher zeigt die Frist durchgehend an, und jedes Gerät dieser Apple-ID kann sie abbrechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then parental controls reset after 24 hours. The TV shows the countdown the whole time, and any device on this Apple ID can cancel it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O zaman ebeveyn denetimi 24 saat sonra sıfırlanır. Televizyon geri sayımı sürekli gösterir ve bu Apple Kimliğindeki her cihaz iptal edebilir."
          }
        }
      }
    },
    "childLock.forgot.noticeReady %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurücksetzen von %@ ist fällig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset requested by %@ is due."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tarafından istenen sıfırlama zamanı geldi."
          }
        }
      }
    },
    "childLock.forgot.noticeRunning %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurücksetzen von %@ verlangt — noch"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset requested by %@ — remaining"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sıfırlama istedi — kalan"
          }
        }
      }
    },
    "childLock.forgot.otherDevice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am iPhone oder iPad bestätigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm on iPhone or iPad"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone veya iPad'de onayla"
          }
        }
      }
    },
    "childLock.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine PIN schützt Konten, Einstellungen und die Sperre selbst. Ohne PIN wirkt nichts davon — das ist Absicht: Eine Sperre ohne Rückweg wäre eine Falle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A PIN protects accounts, settings and the lock itself. Without a PIN none of it applies — by design: a lock with no way back would be a trap."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir PIN; hesapları, ayarları ve kilidin kendisini korur. PIN yoksa hiçbiri geçerli olmaz — bu bilinçlidir: geri dönüşü olmayan bir kilit tuzaktır."
          }
        }
      }
    },
    "childLock.limitHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel über dieser Stufe erscheinen für ein Kinderkonto nicht — auch nicht in der Suche und auch nicht über einen Tiefenlink. Ohne Grenze wird nichts gesiebt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Titles above this level do not appear for a child account — not in search either, and not through a deep link. Without a limit, nothing is filtered."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu seviyenin üzerindeki içerikler çocuk hesabında görünmez — aramada da, derin bağlantıyla da. Sınır yoksa hiçbir şey filtrelenmez."
          }
        }
      }
    },
    "childLock.pinForgotExplain": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keine Hintertür. Zurückgesetzt wird die Kindersicherung im Ganzen: die PIN, die Gerätesperre und die Kontoart. Danach ist nichts mehr gesperrt, und eine neue PIN wird neu festgelegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no back door. Parental controls are reset as a whole: the PIN, the device lock and the account type. Afterwards nothing is locked, and a new PIN is set from scratch."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka kapı yoktur. Ebeveyn denetimi bütünüyle sıfırlanır: PIN, cihaz kilidi ve hesap türü. Sonrasında hiçbir şey kilitli olmaz; yeni PIN sıfırdan belirlenir."
          }
        }
      }
    },
    "childLock.pinReset": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kindersicherung zurücksetzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset parental controls"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ebeveyn denetimini sıfırla"
          }
        }
      }
    },
    "childLock.pinSet": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN ist gesetzt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN is set"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN tanımlı"
          }
        }
      }
    },
    "childLock.pinSetHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlossene Bereiche fragen danach. Ein bestandener Griff gilt für zwei Minuten und für eine Tür."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locked areas ask for it. One successful entry lasts two minutes and opens one door."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilitli alanlar bunu sorar. Doğru giriş iki dakika ve tek bir kapı için geçerlidir."
          }
        }
      }
    },
    "childLock.pinUnset": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine PIN gesetzt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No PIN set"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN tanımlı değil"
          }
        }
      }
    },
    "childLock.pinUnsetHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange keine PIN gesetzt ist, ist nichts gesperrt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As long as no PIN is set, nothing is locked."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN tanımlı olmadığı sürece hiçbir şey kilitli değildir."
          }
        }
      }
    },
    "childLock.ratings": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freigaben zuordnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assign ratings"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaş sınırlarını eşle"
          }
        }
      }
    },
    "childLock.ratingsAllKnown": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Freigabe im Bestand ist eingeordnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every rating in your library is placed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitaplığınızdaki her yaş sınırı eşlendi."
          }
        }
      }
    },
    "childLock.ratingsBlocked %lld": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Titel ist zurzeit gesperrt, weil seine Freigabe nicht eingeordnet ist."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Titel sind zurzeit gesperrt, weil ihre Freigabe nicht eingeordnet ist."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld title is currently blocked because its rating is not placed."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld titles are currently blocked because their rating is not placed."
                }
              }
            }
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld başlık, yaş sınırı eşlenmediği için şu anda engelli."
          }
        }
      }
    },
    "childLock.ratingsByHand": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "von Hand zugeordnet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "assigned by hand"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "elle eşlendi"
          }
        }
      }
    },
    "childLock.ratingsFrom %lld": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ab %lld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "from %lld"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld+"
          }
        }
      }
    },
    "childLock.ratingsHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was Jellyfin an Freigaben schreibt — und was diese App daraus macht. Was sie nicht einordnet, können Sie hier von Hand auf eine Stufe legen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Jellyfin writes as ratings — and what this app makes of it. Anything it cannot place, you can assign to a level here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin’in yazdığı yaş sınırları — ve bu uygulamanın onlardan ne çıkardığı. Eşleyemediklerini burada elle bir seviyeye koyabilirsiniz."
          }
        }
      }
    },
    "childLock.ratingsPassing %lld": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Titel trägt eine Freigabe, die nicht eingeordnet ist. Er kommt durch, weil „Unverstandene sperren“ aus ist."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Titel tragen eine Freigabe, die nicht eingeordnet ist. Sie kommen durch, weil „Unverstandene sperren“ aus ist."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld title carries a rating that is not placed. It passes, because “block unrecognised” is off."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld titles carry a rating that is not placed. They pass, because “block unrecognised” is off."
                }
              }
            }
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld başlık eşlenmemiş bir yaş sınırı taşıyor. „Tanınmayanları engelle“ kapalı olduğu için geçiyorlar."
          }
        }
      }
    },
    "childLock.ratingsScanning": {
