    "settings.liveBrowseHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist der Bereich aus, öffnet „Live“ den zuletzt gesehenen Sender. Sender und Gruppen bleiben aus der Wiedergabe erreichbar — einmal nach links. Zum Suchen und Stöbern schaltest du ihn ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the overview off, Live opens the channel you last watched. Channels and groups stay reachable from playback — press left. Switch it on to search and browse."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alan kapalıyken „Canlı“ en son izlediğin kanalı açar. Kanallar ve gruplar oynatma sırasında sola basarak açılır. Aramak ve gezinmek için aç."
          }
        }
      }
    },
