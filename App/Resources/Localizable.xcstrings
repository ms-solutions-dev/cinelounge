    "login.playlistExpired": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugang wurde erkannt, ist aber abgelaufen. Das ist keine Falscheingabe — beim Anbieter verlängern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The access was recognised but has expired. This is not a typo — renew it with your provider."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişim tanındı ancak süresi dolmuş. Bu bir yazım hatası değil — sağlayıcınızdan yenileyin."
          }
        }
      }
    },
    "login.playlistIntro": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Angaben stehen in der Nachricht deines Anbieters. Groß- und Kleinschreibung zählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will find these in the message from your provider. Case matters."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bilgiler sağlayıcının mesajında yazılıdır. Büyük/küçük harf önemlidir."
          }
        }
      }
    },
    "login.playlistM3UHint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vollständige Adresse der Liste, wie du sie vom Anbieter bekommen hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The full address of the list, exactly as your provider gave it to you."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listenin tam adresi, sağlayıcının verdiği biçimde."
          }
        }
      }
    },
    "login.playlistPasswordHint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird beim Tippen angezeigt — auf dem Fernseher sieht es sonst niemand nach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown while you type — on a TV there is no way to check it otherwise."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazarken görünür — televizyonda başka türlü kontrol edilemez."
          }
        }
      }
    },
    "login.playlistRejected": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter hat den Zugang abgelehnt. Benutzername und Kennwort unterscheiden Groß- und Kleinschreibung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider rejected these credentials. Username and password are case-sensitive."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcı bu bilgileri kabul etmedi. Kullanıcı adı ve şifre büyük/küçük harfe duyarlıdır."
          }
        }
      }
    },
    "login.playlistServerHint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der Server, etwa http://beispiel.tv — ohne Benutzername und ohne den Rest der Adresse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server only, e.g. http://example.tv — without the username or the rest of the address."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca sunucu, örneğin http://ornek.tv — kullanıcı adı ve adresin kalanı olmadan."
          }
        }
      }
    },
    "login.playlistTitle": {
