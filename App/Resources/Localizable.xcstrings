    "pairing.sharedHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Profil gehört einem anderen Konto. Was hier geschieht, sieht auch das andere Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This profile belongs to another account. What happens here is visible on the other device too."
