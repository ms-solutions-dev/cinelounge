    "settings.heroLibrariesHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Bibliotheken oben bildschirmfüllend erscheinen dürfen. Alles ist an; abwählen, wenn darin private Aufnahmen liegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which libraries may appear full-screen at the top. Everything is on by default — turn one off if it holds private recordings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangi kitaplıklar üstte tam ekran görünebilir. Tümü açık; özel kayıtlar varsa kapatın."
          }
        }
      }
    },
    "settings.homeAllGroups": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Gruppen"
          }
        },
