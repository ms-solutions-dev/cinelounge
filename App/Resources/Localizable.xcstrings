        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Motor hat sie nicht öffnen können. Möglich sind ein Ausfall des Servers, eine fehlende Datei oder ein Format, das dieses Gerät nicht beherrscht."
          }
        },
        "en": {
