    "settings.liveAdultTrust": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kennzeichnung kommt vom Anbieter und kann unvollständig sein. Wer sich darauf verlässt, sollte das wissen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The marking comes from the provider and may be incomplete. Worth knowing before relying on it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işaret sağlayıcıdan gelir ve eksik olabilir. Ona güvenmeden önce bilmek gerekir."
          }
        }
      }
    },
    "settings.liveBrowse": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersichtsbereich"
          }
