    "about.licences.missing": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lizenzliste fehlt in diesem Bau. Sie wird von scripts/lizenzen.py erzeugt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The licence list is missing from this build. It is generated by scripts/lizenzen.py."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yapıda lisans listesi eksik. scripts/lizenzen.py tarafından üretilir."
          }
        }
      }
    },
    "about.licences.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App benutzt fremde Pakete. Ihre Lizenzen verlangen, dass Hinweis und Text mitgeliefert werden — hier stehen sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app uses third-party packages. Their licences require notice and text to be shipped along — here they are."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulama üçüncü taraf paketler kullanır. Lisansları, bildirim ve metnin birlikte verilmesini ister — işte buradalar."
          }
        }
      }
    },
    "about.tmdb.notice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anwendung nutzt TMDB und die TMDB-APIs, wird von TMDB aber weder unterstützt noch zertifiziert oder anderweitig genehmigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This application uses TMDB and the TMDB APIs but is not endorsed, certified, or otherwise approved by TMDB."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulama TMDB'yi ve TMDB API'lerini kullanır, ancak TMDB tarafından onaylanmamış, sertifikalandırılmamış veya başka şekilde yetkilendirilmemiştir."
          }
        }
      }
    },
    "about.privacy.deviceText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugangsdaten liegen im Schlüsselbund des Geräts. Vorschaubilder, Listen und der Fortschritt liegen im Zwischenspeicher. Beides verlässt diesen Fernseher nur, wenn du einen Diagnosebericht einreichst — und der zeigt vorher, was darin steht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Credentials live in the device keychain. Artwork, lists and progress live in the cache. Neither leaves this TV unless you submit a diagnostics report — and that shows you its contents first."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişim bilgileri cihazın anahtar zincirinde durur. Görseller, listeler ve ilerleme ön bellekte durur. İkisi de bir tanılama raporu göndermedikçe bu televizyondan çıkmaz — rapor da içeriğini önceden gösterir."
          }
        }
      }
    },
    "about.privacy.deviceTitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was auf diesem Fernseher liegt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What stays on this TV"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu televizyonda ne kalıyor"
          }
        }
      }
    },
    "about.privacy.removeText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter „Speicher“ lässt sich der Zwischenspeicher leeren. Unter „Jellyfin“ entfernst du einen Zugang samt seinen Zugangsdaten. Wer die App löscht, nimmt beides mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under “Storage” you can clear the cache. Under “Jellyfin” you remove an access along with its credentials. Deleting the app takes both with it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Depolama” altında ön belleği boşaltabilirsin. “Jellyfin” altında bir erişimi ve bilgilerini kaldırırsın. Uygulamayı silmek ikisini de götürür."
          }
        }
      }
    },
    "about.privacy.removeTitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie du es wieder los wirst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to get rid of it"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasıl silersin"
          }
        }
      }
    },
    "about.privacy.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CineLounge hat keinen eigenen Dienst: kein Konto, keinen Server, niemanden, der etwas einsammelt. Die App wendet sich ausschließlich an die Dienste, die du selbst eingetragen hast — dein Jellyfin, deine IPTV-Zugänge, deinen CL-Server. Keine Werbung, keine Analyse, keine Kennungen für Dritte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CineLounge has no service of its own: no account, no server, nobody collecting anything. The app only talks to the services you entered yourself — your Jellyfin, your IPTV accounts, your CL server. No ads, no analytics, no third-party identifiers."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CineLounge’un kendi hizmeti yok: hesap yok, sunucu yok, veri toplayan kimse yok. Uygulama yalnızca senin girdiğin hizmetlerle konuşur — Jellyfin’in, IPTV erişimlerin, CL-Server’ın. Reklam yok, analiz yok, üçüncü taraf kimlikleri yok."
          }
        }
      }
    },
    "about.privacy.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wohin geht etwas"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where data goes"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veriler nereye gider"
          }
        }
      }
    },
    "about.report.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was über einen eigenen IPTV-Zugang hereinkommt, prüft vorher niemand. Unter „Diagnose“ steht der Weg, einen Bericht einzureichen — an dieselbe Adresse geht auch eine Meldung über einen Inhalt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody vets what comes in through your own IPTV account. Under “Diagnostics” you will find the way to submit a report — a complaint about content goes to the same address."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi IPTV erişiminden geleni kimse önceden denetlemez. “Tanılama” altında rapor gönderme yolu var — bir içerik şikâyeti de aynı adrese gider."
          }
        }
      }
    },
    "about.report.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas melden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report something"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şey bildir"
          }
        }
      }
    },
    "accounts.moveBack": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Adresse"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Different address"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka adres"
          }
        }
      }
    },
    "accounts.moveCheck": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen"
          }
        },
