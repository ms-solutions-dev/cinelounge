    "pairing.getHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fernseher zeigt einen Code und wartet. Wer ihn scannt, schickt sein Profil hierher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV shows a code and waits. Whoever scans it sends their profile here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Televizyon bir kod gösterir ve bekler. Kodu tarayan kişi profilini buraya gönderir."
          }
        }
      }
    },
    "pairing.getSteps": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne diesen Code mit der Kamera deines iPhones oder iPads. Das Profil kommt dann von selbst herüber."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan this code with the camera of your iPhone or iPad. The profile then comes over by itself."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kodu iPhone'unun ya da iPad'inin kamerasıyla tara. Profil sonra kendiliğinden gelir."
          }
        }
      }
    },
    "pairing.getTitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Profil holen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fetch a profile"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir profil al"
          }
        }
      }
    },
    "pairing.giveHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fernseher zeigt einen Code. Wer ihn mit dem Handy scannt, bekommt dieses Profil — mit Zugängen, Stand und Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV shows a code. Whoever scans it with their phone receives this profile — with its access, progress and settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Televizyon bir kod gösterir. Onu telefonuyla tarayan kişi bu profili alır — erişimleri, ilerlemesi ve ayarlarıyla."
          }
        }
      }
    },
    "pairing.giveSteps": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne diesen Code mit der Kamera deines iPhones oder iPads."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan this code with the camera of your iPhone or iPad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kodu iPhone'unun ya da iPad'inin kamerasıyla tara."
          }
        }
      }
    },
    "pairing.participantsHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein angenommener Link gilt weiter, bis er zurückgenommen wird. Lange auf eine Zeile drücken entfernt dieses Gerät aus der Freigabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An accepted link stays valid until it is taken back. Press and hold a row to remove that device from the share."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kabul edilmiş bir bağlantı geri alınana kadar geçerlidir. Bir satıra uzun basmak o cihazı paylaşımdan çıkarır."
          }
        }
      }
    },
    "pairing.removeHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lange drücken zum Entfernen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press and hold to remove"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaldırmak için uzun basın"
          }
        }
      }
    },
    "pairing.sharedBy %@": {
      "extractionState": "manual",
      "localizations": {
