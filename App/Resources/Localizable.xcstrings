    "player.unplayableCodec": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Video kann das Apple TV nicht abspielen. Sein Bildformat lässt sich hier weder abspielen noch umwandeln — über Jellyfin ginge es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Apple TV cannot play this video. Its video format can neither be played nor converted here — through Jellyfin it would work."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV bu videoyu oynatamıyor. Görüntü biçimi burada ne oynatılabiliyor ne de dönüştürülebiliyor — Jellyfin üzerinden mümkün olurdu."
          }
        }
      }
    },
