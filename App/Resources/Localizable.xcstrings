        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off means: no sidebar entry, no shelf, no CL server results. The address stays."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı: kenar çubuğunda giriş yok, raf yok, CL-Server sonucu yok. Adres kalır."
          }
        }
      }
    },
    "settings.portals.findServer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Netz suchen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search the network"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağda ara"
          }
        }
      }
    },
    "settings.portals.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mediatheken kommen von deinem CL-Server im Heimnetz. Welche es gibt und wie schnell sie antworten, ist dort eingestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The services come from your CL server on the home network. Which ones exist and how fast they answer is set up there."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Servisler ev ağındaki CL-Server’ından gelir. Hangilerinin olduğu ve ne kadar hızlı yanıt verdikleri orada ayarlanır."
          }
        }
      }
    },
    "settings.portals.joinsCardHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücken, um zu entscheiden. Freigeben verlangt deine PIN und eine Rolle; eine Vorgabe gibt es nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press to decide. Approving requires your PIN and a role; there is no default."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karar vermek için bas. Onaylamak PIN'ini ve bir rol gerektirir; varsayılan yoktur."
          }
        }
      }
    },
    "settings.portals.noService": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Adresse eingetragen — ohne sie gibt es keine Mediatheken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No address entered — without one there are no services."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres girilmedi — adres olmadan servis olmaz."
          }
        }
      }
    },
    "settings.portals.notFound": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Heimnetz meldet sich kein CineLounge-Server. Läuft er, und hängt dieser Fernseher am selben Netz? Sonst trag die Adresse von Hand ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No CineLounge server is announcing itself on the home network. Is it running, and is this TV on the same network? Otherwise enter the address by hand."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ev ağında kendini duyuran bir CineLounge sunucusu yok. Çalışıyor mu ve bu televizyon aynı ağda mı? Değilse adresi elle gir."
          }
        }
      }
    },
    "settings.portals.pairing": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerät koppeln"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair this device"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazı eşleştir"
          }
        }
      }
    },
    "settings.portals.pairingHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Leitstand des CL-Servers im Browser einen Kopplungscode erzeugen und hier eintippen. Er gilt fünf Minuten. Groß oder klein ist gleich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a pairing code in the CL-Server console in your browser and type it here. It is valid for five minutes. Upper or lower case makes no difference."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcıda CL-Server panosunda bir eşleştirme kodu oluştur ve buraya yaz. Beş dakika geçerli. Büyük ya da küçük harf fark etmez."
          }
        }
      }
    },
    "settings.portals.pairingPrompt": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ABC123"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ABC123"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ABC123"
          }
        }
      }
    },
    "settings.portals.plainOnly": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der CL-Server antwortet nicht über https:// — er hört im Heimnetz im Klartext. Trag die Adresse ohne https:// ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The CL-Server does not answer over https:// — it listens in the clear on the home network. Enter the address without https://."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CL-Server https:// üzerinden yanıt vermez — ev ağında şifresiz dinler. Adresi https:// olmadan gir."
          }
        }
      }
    },
    "settings.portals.sharedHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An heißt: Diese Mediathek führt „Weiterschauen“ und Favoriten in ihrem eigenen Bereich unter CL-Server und nicht auf der Startseite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On means: this library keeps “Continue watching” and favourites in its own area under CL-Server, not on the home screen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık: Bu kütüphane „İzlemeye devam et“ ve favorileri ana sayfada değil, CL-Server altındaki kendi alanında tutar."
          }
        }
      }
    },
