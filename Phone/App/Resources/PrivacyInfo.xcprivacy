<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Die Datenschutzerklärung, die Apple seit Mai 2024 verlangt (AP10). Die App
	     sammelt nichts und verfolgt niemanden: Berichte gehen auf den Medienserver
	     des Zuschauers, nicht an uns. Was hier steht, sind die drei Schnittstellen,
	     für die Apple einen Grund verlangt — nachgezählt am Quelltext, nicht geraten. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- UserDefaults über @AppStorage und die Ablagen (Farbmuster, Reiterwahl, Verlauf). -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<!-- Dateizeitstempel der eigenen Ablage (Bildablage räumt nach Alter). -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<!-- Freier Speicher: gezeigt im Speicherbildschirm (85F4.1) und geprüft, bevor
		     etwas geschrieben wird (E174.1). -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>85F4.1</string>
				<string>E174.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
