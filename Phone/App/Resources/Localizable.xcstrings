    "settings.diagnostics.clear.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehler, Aufzeichnung und Oberfläche werden gelöscht — alle drei. Was noch nicht eingereicht ist, ist danach weg und kommt nur wieder, wenn der Fehler wieder auftritt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Errors, recording and interface are all deleted — all three. Anything not yet filed is gone afterwards, and only comes back if the fault happens again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatalar, kayıt ve arayüz silinir — üçü de. Henüz gönderilmemiş olan sonrasında kaybolur ve ancak hata yeniden oluşursa geri gelir."
          }
        }
      }
    },
