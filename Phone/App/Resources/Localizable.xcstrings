    "childLock.ratings.unassign": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuordnung zurücknehmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove assignment"
