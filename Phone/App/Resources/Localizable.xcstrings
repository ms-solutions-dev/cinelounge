    "accounts.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Wechsel meldet nicht ab: Die Zugangsmarke bleibt liegen, und die zwischengespeicherten Bilder auch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching does not sign out: the access token stays, and so do the cached images."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçiş yapmak oturumu kapatmaz: erişim anahtarı da önbellekteki görseller de kalır."
          }
        }
      }
    },
    "accounts.manage": {
      "extractionState": "manual",
      "localizations": {
