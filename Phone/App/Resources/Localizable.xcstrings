      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält jede Wiedergabe und jede Messung fest. Nur einschalten, solange etwas gesucht wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps every playback and every measurement. Only switch on while something is being looked for."
          }
