    "settings.look.systemLanguage": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasselbe steht in den Systemeinstellungen unter CineLounge → Sprache. Beide Wege legen denselben Schalter um."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same setting lives in System Settings under CineLounge → Language. Both flip the same switch."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı ayar Sistem Ayarları’nda CineLounge → Dil altında da var. İkisi de aynı anahtarı çevirir."
          }
        }
      }
    },
    "settings.none": {
