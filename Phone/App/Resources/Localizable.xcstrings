    "settings.portals.bridge.isInvite": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist eine Einladung und keine Adresse. Sie gehört in die Anmeldung darunter — dort bringt sie die Adresse gleich mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is an invitation, not an address. It belongs in the sign-in below — there it brings the address along."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir davet, adres değil. Aşağıdaki oturum bölümüne ait — orada adresi de beraberinde getirir."
          }
        }
      }
    },
    "settings.portals.bridge.ok": {
