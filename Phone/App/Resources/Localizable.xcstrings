            "state": "translated",
            "value": "Wie der Anbieter sie liefert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As the provider delivers it"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcı nasıl veriyorsa"
          }
        }
      }
    },
    "stock.asDeliveredBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter hält je Titel genau einen Strom. Niemand rechnet um — nicht die App, nicht der Anbieter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider keeps exactly one stream per title. Nobody transcodes — not the app, not the provider."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcı başlık başına tam olarak bir akış tutar. Kimse dönüştürmez — ne uygulama ne sağlayıcı."
          }
        }
      }
    },
    "stock.asFile": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei, die in Jellyfin liegt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file that lives in Jellyfin"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin’de duran dosya"
          }
        }
      }
    },
    "stock.asFileBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kleinere Fassung müsste Jellyfin erst berechnen, und das Ergebnis ist ein Strom statt einer Datei: Er lässt sich nicht fortsetzen, also beginnt jeder Abbruch von vorn. Heruntergeladen wird deshalb, was da ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A smaller version would have to be computed first, and the result is a stream rather than a file: it cannot be resumed, so every interruption starts over. What gets downloaded is therefore what is there."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha küçük bir sürümü Jellyfin’in önce hesaplaması gerekir ve sonuç bir dosya değil akıştır: sürdürülemez, yani her kopuş baştan başlar. Bu yüzden var olan indirilir."
          }
        }
      }
    },
