    "settings.portals.bridgeService": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter dieser Adresse antwortet ein CL-Server der alten Art. Er kennt keine Personen — es gibt nichts anzumelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An old-style CL-Server answers at this address. It knows no people — there is nothing to sign in to."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adreste eski tür bir CL-Server yanıt veriyor. Kişi tanımıyor — oturum açacak bir şey yok."
          }
        }
      }
    },
    "settings.portals.enabled.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus heißt: kein Reiter, kein Regal, keine Treffer vom CL-Server. Die Adresse bleibt eingetragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off means: no tab, no shelf, no CL server results. The address stays."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı: sekme yok, raf yok, CL-Server sonucu yok. Adres kalır."
          }
        }
      }
    },
    "settings.portals.invite": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einladung einlösen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Redeem invitation"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daveti kullan"
          }
        }
      }
    },
    "settings.portals.inviteHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Link aus dem Leitstand hier einfügen — er bringt die Adresse des Servers mit. Ein Kopplungscode geht auch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the link from the console here — it carries the server address with it. A pairing code works too."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Panodan gelen bağlantıyı buraya yapıştır — sunucu adresini de beraberinde getirir. Eşleştirme kodu da olur."
          }
        }
      }
    },
    "settings.portals.inviteNeedsAddress": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server ist nicht zu finden. Trag seine Adresse oben ein (Rechnername oder IP, mit Nummer) und löse die Einladung dann ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server cannot be found. Enter its address above (host name or IP, with port), then redeem the invitation."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu bulunamıyor. Adresini yukarıya gir (makine adı ya da IP, port ile), sonra daveti kullan."
          }
        }
      }
    },
    "settings.portals.invitePrompt": {
