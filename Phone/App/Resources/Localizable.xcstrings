    "settings.portals.account.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Stand hängt an der Person und nicht am Gerät: Auf dem Telefon anfangen, am Fernseher weiterschauen. Wer das Profil wechseln will, meldet sich neu an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progress belongs to the person, not the device: start on the phone, continue on the television. To switch profile, sign in again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlerleme cihaza değil kişiye aittir: telefonda başla, televizyonda devam et. Profil değiştirmek için yeniden oturum aç."
          }
        }
      }
    },
    "settings.portals.bridge.check": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung prüfen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check connection"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantıyı denetle"
          }
        }
