    "accounts.signOut.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist das letzte Konto. Mit ihm geht mehr weg als die Anmeldung:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the last account. More than the sign-in goes with it:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu son hesap. Onunla birlikte oturumdan fazlası gider:"
          }
        }
      }
    },
    "accounts.signOut.title": {
      "extractionState": "manual",
      "localizations": {
