    "cert.changed.anyway": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trotzdem vertrauen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trust anyway"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yine de güven"
          }
        }
      }
    },
    "cert.changed.explain": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entweder hat der Server ein neues Zertifikat bekommen — oder jemand im selben Netz gibt sich als er aus. Von hier aus sind die beiden nicht zu unterscheiden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Either the server was given a new certificate — or someone on the same network is impersonating it. From here the two cannot be told apart."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya sunucu yeni bir sertifika aldı ya da aynı ağdaki biri onun gibi görünüyor. Buradan ikisi ayırt edilemez."
          }
        }
      }
    },
    "cert.changed.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du nicht sicher bist: abbrechen und den Fingerabdruck am Server selbst nachsehen. Er steht dort, wo das Zertifikat erzeugt wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you are not sure: cancel and look up the fingerprint on the server itself. It is where the certificate was created."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Emin değilsen: vazgeç ve parmak izine sunucunun kendisinden bak. Sertifikanın oluşturulduğu yerde durur."
          }
        }
      }
    },
    "cert.changed.known": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisher bestätigt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmed until now"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdiye kadar onaylı"
          }
        }
      }
    },
    "cert.changed.presented": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt gezeigt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown now"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi gösterilen"
          }
        }
      }
    },
    "cert.changed.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zertifikat hat sich geändert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The certificate has changed"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sertifika değişti"
          }
        }
      }
    },
    "cert.changed.warn": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Erklärungen, und nur eine ist harmlos"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two explanations, and only one is harmless"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki açıklama var, yalnızca biri zararsız"
          }
        }
      }
    },
    "cert.explain": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server weist sich mit einem Zertifikat aus, das keine bekannte Stelle bestätigt hat. Im Heimnetz ist das der Normalfall. Vergleiche den Fingerabdruck einmal mit dem, was am Server steht — danach wird genau dieses Zertifikat erwartet und jedes andere fällt auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server identifies itself with a certificate no known authority has confirmed. On a home network that is normal. Compare the fingerprint once with what the server shows — from then on exactly this certificate is expected, and any other one stands out."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sunucu, bilinen bir makamın onaylamadığı bir sertifikayla kimliğini gösteriyor. Ev ağında bu normaldir. Parmak izini bir kez sunucudakiyle karşılaştır — bundan sonra tam olarak bu sertifika beklenir ve başka her biri fark edilir."
          }
        }
      }
    },
    "cert.fingerprint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fingerabdruck"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fingerprint"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parmak izi"
          }
        }
      }
    },
    "cert.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigt gilt es nur auf diesem Gerät und nur für diesen Server. Zurücknehmen lässt es sich in Einstellungen → Konto → Zertifikate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The confirmation applies to this device only and to this server only. You can withdraw it in Settings → Account → Certificates."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onay yalnızca bu cihaz ve yalnızca bu sunucu için geçerlidir. Ayarlar → Hesap → Sertifikalar altında geri alınabilir."
          }
        }
      }
    },
    "cert.host": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu"
          }
        }
      }
    },
    "cert.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selbst ausgestelltes Zertifikat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Self-signed certificate"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendinden imzalı sertifika"
          }
        }
      }
    },
    "certs.empty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keinem Zertifikat vertraut. Das ist der Normalfall: Server mit gültigem Zertifikat brauchen hier keinen Eintrag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No certificate trusted yet. That is normal: servers with a valid certificate need no entry here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz güvenilen sertifika yok. Bu normaldir: geçerli sertifikası olan sunucular burada yer almaz."
          }
        }
      }
    },
    "certs.revoke": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertrauen widerrufen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoke trust"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güveni geri al"
          }
        }
      }
    },
    "certs.revokeText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim nächsten Verbinden fragt die App wieder nach dem Fingerabdruck. Bis dahin bleibt der Server erreichbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next time it connects, the app will ask for the fingerprint again. Until then the server stays reachable."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sonraki bağlanmada uygulama parmak izini yeniden sorar. O ana dek sunucuya erişilebilir."
          }
        }
      }
    },
    "childLock.account": {
