        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download finished"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirme tamamlandı"
          }
        }
      }
    },
    "stock.emptyBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Titel kommt hierher über „Herunterladen“ — am Titel selbst, an einer Folge oder an einer ganzen Staffel. Danach läuft er ohne Netz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Titles arrive here via “Download” — in the menu on any title, an episode or a whole season. After that they play without a network."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlıklar buraya “İndir” ile gelir — her başlıkta, bir bölümde veya tüm sezonda. Sonrasında ağ olmadan oynatılır."
          }
        }
      }
    },
    "stock.emptyTitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts heruntergeladen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing downloaded yet"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz indirilen yok"
          }
        }
      }
    },
    "stock.errorAccountBusy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Zugang erlaubt eine Verbindung, und die ist gerade belegt. Beende die Wiedergabe oder warte kurz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account allows one connection and it is busy right now. Stop playback or wait a moment."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabın tek bağlantıya izin veriyor ve şu an meşgul. Oynatmayı durdur ya da biraz bekle."
          }
        }
      }
    },
    "stock.errorDamaged": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei kam beschädigt an und wurde verworfen. Ein neuer Versuch lädt sie von vorn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file arrived damaged and was discarded. Trying again downloads it from the start."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya bozuk geldi ve silindi. Yeniden denemek onu baştan indirir."
          }
        }
      }
    },
    "stock.errorDash": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Quelle liefert MPEG-DASH. Das kann der Vorrat nicht laden — wähle eine andere Fassung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This source delivers MPEG-DASH. Downloads cannot handle it — pick another version."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kaynak MPEG-DASH veriyor. İndirme bunu alamıyor — başka bir sürüm seç."
          }
        }
      }
    },
    "stock.errorDrm": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Titel ist kopiergeschützt und lässt sich nicht in den Vorrat legen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This title is copy-protected and cannot be downloaded."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu başlık kopya korumalı, indirilemiyor."
          }
        }
      }
    },
    "stock.errorEmptyList": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Quelle hat eine leere Liste geschickt. Öffne den Titel noch einmal und leg ihn neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source sent an empty playlist. Open the title again and add it anew."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynak boş bir liste gönderdi. Başlığı yeniden aç ve tekrar ekle."
          }
        }
      }
    },
    "stock.errorEncrypted": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stücke dieses Titels sind verschlüsselt. Wähle im Ladeblatt eine andere Fassung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This title's parts are encrypted. Pick another version in the download sheet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu başlığın parçaları şifreli. İndirme sayfasında başka bir sürüm seç."
          }
        }
      }
    },
    "stock.errorEndlessStream": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist ein laufender Strom ohne Ende — es gibt nichts, was fertig würde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is a running stream with no end — there is nothing to finish."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, sonu olmayan sürekli bir yayın — bitecek bir şey yok."
          }
        }
      }
    },
    "stock.errorLiveNoEnd": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sendung läuft noch. Wenn sie zu Ende ist, lässt sie sich legen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This programme is still running. Once it has ended you can download it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yayın hâlâ sürüyor. Bittiğinde indirebilirsin."
          }
        }
      }
    },
    "stock.errorNetwork": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung verloren. Tipp auf Fortsetzen, sobald wieder Netz da ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection lost. Tap resume once you are back online."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı koptu. Yeniden çevrimiçi olunca devam'a dokun."
          }
        }
      }
    },
    "stock.errorNoAddress": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mediathek gibt für diesen Titel gerade keine Videoadresse heraus. Das liegt an der Seite, nicht an dir — manchmal hilft Warten, manchmal muss der Ableser nachgezogen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service is not handing out a video address for this title right now. That is the site, not you — sometimes waiting helps, sometimes the reader needs updating."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Servis şu anda bu içerik için bir video adresi vermiyor. Sorun sende değil sitede — bazen beklemek yeter, bazen okuyucunun güncellenmesi gerekir."
          }
        }
      }
    },
    "stock.errorNoResumableSource": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Quelle liefert diese Datei stückweise. Wähle im Ladeblatt eine andere Fassung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No source delivers this file in parts. Pick another version in the download sheet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir kaynak bu dosyayı parça parça vermiyor. İndirme sayfasında başka bir sürüm seç."
          }
        }
      }
    },
    "stock.errorNoSpace": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Platz mehr. Entferne etwas aus dem Vorrat und starte den Download neu."
          }
