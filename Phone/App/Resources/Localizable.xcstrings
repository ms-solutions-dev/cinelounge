    "childLock.serverSection": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin filtert mit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin filters too"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
