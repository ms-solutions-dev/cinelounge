    "sport.noGuide.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wird aus der Programmzeitschrift gerechnet und nicht vom Anbieter geliefert. Einmal abgleichen, dann steht er da."
          }
