          }
        }
      }
    },
    "privacy.delete": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie du es loswirst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to get rid of it"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasıl silersiniz"
          }
        }
      }
    },
    "privacy.deleteText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter Speicher steht, was auf diesem Gerät liegt, und dort lässt es sich auch löschen. Beim Löschen der App verschwindet alles mit — bis auf den Schlüsselbund, den iOS gesondert führt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage shows what is on this device, and lets you delete it there. Deleting the app removes everything with it — except the keychain, which iOS keeps separately."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depolama, bu cihazda ne olduğunu gösterir ve oradan silebilirsiniz. Uygulamayı silmek her şeyi birlikte götürür — iOS'un ayrı tuttuğu anahtar zinciri hariç."
          }
        }
      }
    },
    "privacy.what": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Diagnosebericht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The diagnostic report"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanı raporu"
          }
        }
      }
    },
    "privacy.whatText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur wenn du ihn selbst schickst, und nur an dein eigenes Jellyfin. Er enthält Gerät, Systemfassung und das Fehlerprotokoll; Adressen und Titel sind geschwärzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only when you send it yourself, and only to your own Jellyfin. It contains the device, the system version and the error log; addresses and titles are redacted."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca siz gönderirseniz ve yalnızca kendi Jellyfin’inize. Cihaz, sistem sürümü ve hata günlüğünü içerir; adresler ve başlıklar karartılır."
          }
        }
      }
    },
    "privacy.where": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was auf dem Gerät liegt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What stays on the device"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazda ne kalır"
          }
        }
      }
    },
    "privacy.whereText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugangsdaten, PIN und API-Schlüssel liegen im Schlüsselbund von iOS. Auf der Platte liegen: was du zuletzt gesehen hast, das Fehlerprotokoll, die geladenen Bilder und die zwischengespeicherten Sender- und Titellisten. Nichts davon verlässt das Gerät von selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Credentials, PIN and API keys live in the iOS keychain. On disk: what you watched last, the error log, downloaded images, and cached channel and title lists. None of it leaves the device on its own."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişim bilgileri, PIN ve API anahtarları iOS anahtar zincirinde durur. Diskte: en son ne izlediğiniz, hata günlüğü, indirilen görseller ve önbelleğe alınan kanal ve içerik listeleri. Hiçbiri kendiliğinden cihazdan çıkmaz."
          }
        }
      }
    },
    "privacy.who": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer bekommt etwas"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who receives anything"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimlere gider"
          }
        }
      }
    },
    "privacy.whoText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand von uns. Es gibt kein CineLounge-Konto und keinen Dienst von uns. Die App wendet sich nur an die Dienste, die du selbst eingetragen hast: dein Jellyfin, deinen IPTV-Anbieter, deinen CL-Server. Trägst du Schlüssel für OMDb oder TMDb ein, fragt sie zusätzlich dort nach Bewertungen und Bildern. Keine Werbung, keine Analyse, keine Kennungen für Dritte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody at our end. There is no CineLounge account and no service of ours. The app only talks to the services you entered yourself: your Jellyfin, your IPTV provider, your CL server. If you enter keys for OMDb or TMDb, it also asks those for ratings and images. No advertising, no analytics, no identifiers for third parties."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bizden kimse. CineLounge hesabı ve bizim bir hizmetimiz yoktur. Uygulama yalnızca kendi girdiğiniz servislerle konuşur: Jellyfin’iniz, IPTV sağlayıcınız, CL-Server’ınız. OMDb veya TMDb anahtarı girerseniz puan ve görseller için onlara da sorar. Reklam yok, analiz yok, üçüncü taraflar için kimlik yok."
          }
        }
      }
    },
    "profiles.avatarChange": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilbild ändern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change profile picture"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil resmini değiştir"
          }
        }
      }
    },
    "profiles.pin": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil-PIN"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile PIN"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil PIN’i"
          }
        }
      }
    },
    "profiles.pinForgotHint %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die PIN von „%@“ fällt auf allen Geräten — nach 24 Stunden oder sofort, wenn ein anderes Gerät mit derselben Apple-ID bestätigt. Bis dahin lässt sich das von jedem Gerät abbrechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PIN of “%@” is removed on every device — after 24 hours, or right away once another device on the same Apple ID confirms. Until then any device can cancel it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” PIN’i tüm cihazlarda kalkar — 24 saat sonra ya da aynı Apple Kimliğindeki başka bir cihaz onaylarsa hemen. O zamana kadar her cihaz iptal edebilir."
          }
        }
      }
    },
    "profiles.pinForgotReady": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die PIN darf fallen. Sie wird auf allen Geräten entfernt; eine neue lässt sich danach im Personenblatt vergeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PIN may be removed. It is removed on every device; a new one can be set afterwards from the profile sheet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN kaldırılabilir. Tüm cihazlarda kaldırılır; yenisi daha sonra profil sayfasından belirlenebilir."
          }
        }
      }
    },
    "profiles.pinSetText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier Ziffern. Sie gelten auf allen Geräten mit diesem Apple Account."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four digits. They apply on every device signed in to this Apple Account."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dört hane. Bu Apple Hesabı’na bağlı tüm cihazlarda geçerlidir."
          }
        }
      }
    },
