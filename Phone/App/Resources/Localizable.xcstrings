    },
    "settings.playback.animeOriginalText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tonspur-Automatik nimmt die erste passende — bei einem synchronisierten Anime ist das die deutsche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audio-track automation takes the first match — for a dubbed anime that is the local one."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses parçası otomatiği ilk uyanı alır — dublajlı bir animede bu yerel olandır."
          }
        }
      }
    },
    "settings.playback.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was hier steht, gilt für alle Quellen. Was eine einzelne Datei mitbringt, entscheidet der Spieler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is set here applies to every source. What an individual file brings is decided by the player."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buradaki ayarlar tüm kaynaklar için geçerlidir. Tek bir dosyanın getirdiğine oynatıcı karar verir."
          }
        }
      }
    },
    "settings.playback.plainSubtitlesText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ASS-Untertitel (häufig bei Anime) bringen ihr eigenes Schriftbild mit – Positionen, Farben, Karaoke. Eingeschaltet kommen sie als schlichter Text im Schriftbild des Systems, wie alle anderen Untertitel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ASS subtitles (common in anime) carry their own styling – positions, colours, karaoke. When this is on, they arrive as plain text in the system's styling, like all other subtitles."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ASS altyazıları (animelerde yaygın) kendi biçimini taşır – konum, renk, karaoke. Açıkken diğer tüm altyazılar gibi sistemin biçiminde düz metin olarak gelir."
          }
        }
      }
    },
    "settings.playback.preview": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So sehen die Untertitel im Film aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is how subtitles look in a film."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altyazılar filmde böyle görünür."
          }
        }
      }
    },
