    "portal.empty.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ebene ist leer — das ist kein Fehler. Eine Seite hinter der letzten sieht genauso aus wie eine ohne Inhalt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This level is empty — that is not an error. A page past the last one looks exactly like one with no content."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu düzey boş — bu bir hata değil. Sonuncudan sonraki bir sayfa, içeriği olmayan bir sayfayla aynı görünür."
          }
        }
      }
    },
