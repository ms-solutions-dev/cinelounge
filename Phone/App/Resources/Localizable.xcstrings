    "settings.portals.bridge.empty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Adresse eingetragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No address entered yet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz adres girilmedi."
          }
        }
      }
    },
    "settings.portals.bridge.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Adresse gibt es keine Mediatheken. Trag ein, wo dein CL-Server steht — Rechnername oder IP, mit Nummer. Er ist dein Rechner, nicht der eines Anbieters."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without an address there are no services. Enter where your CL server runs — host name or IP, with port. It is your machine, not a provider’s."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres olmadan servis olmaz. CL-Server’ının nerede çalıştığını gir — makine adı ya da IP, port ile. O senin makinen, bir sağlayıcının değil."
          }
        }
      }
    },
