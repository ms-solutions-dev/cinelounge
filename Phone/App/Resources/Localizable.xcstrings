    "childLock.ratings.understood.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„TV-MA“ und „TV-14“ kommen aus dem amerikanischen Fernsehen und haben keine deutsche Entsprechung. Eine Zuordnung von Hand ist eine Annahme — sie steht hier, damit sie nachprüfbar ist und nicht im Quelltext verschwindet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“TV-MA” and “TV-14” come from American television and have no German equivalent. A hand-made assignment is an assumption — it stands here so it can be checked instead of vanishing into the source."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "„TV-MA“ ve „TV-14“ Amerikan televizyonundan gelir ve Almanca karşılığı yoktur. Elle yapılan eşleme bir varsayımdır — kaynak kodda kaybolmasın, denetlenebilsin diye burada durur."
          }
        }
      }
    },
    "childLock.ratingsSection": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Altersfreigaben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Age ratings"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaş dereceleri"
          }
        }
      }
    },
    "childLock.reset.cancel": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurücksetzen abbrechen"
          }
        },
        "en": {
