    "search.none.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu diesem Wort liegt in keinem der eingerichteten Bestände etwas. Ein kürzeres Wort trifft mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None of the sources that are set up hold anything for this term. A shorter term matches more."
