    "pairing.giveSteps": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne diesen Code mit der Kamera des anderen Geräts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan this code with the camera of the other device."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kodu diğer cihazın kamerasıyla tara."
          }
        }
      }
    },
    "pairing.handed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinterlegt. Das andere Gerät holt das Profil jetzt ab."
          }
        },
        "en": {
