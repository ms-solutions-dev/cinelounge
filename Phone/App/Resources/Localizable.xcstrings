    "settings.live.sports.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Sportarten der Spielplan zeigt. Abgeschaltete fehlen in der Chipleiste und in der Liste. Was hier angehakt ist, steht später genau so über dem Spielplan."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which sports the schedule shows. Switched-off ones are missing from the chip row and from the list. What is ticked here appears exactly like that above the schedule later."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Programın gösterdiği spor dalları. Kapatılanlar çip çubuğunda ve listede yer almaz. Burada işaretlenen, sonra programın üstünde aynen görünür."
          }
        }
      }
    },
    "settings.look.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprache gilt nur für diese App. Das Farbmuster ändert den Raum, nicht das Zeichen — die Marke bleibt in jedem Muster dieselbe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The language applies to this app only. The theme changes the room, not the sign — the brand stays the same in every theme."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dil yalnızca bu uygulama için geçerlidir. Tema odayı değiştirir, işareti değil — marka her temada aynı kalır."
          }
        }
      }
    },
    "settings.look.icon.bogen": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bogen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arch"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemer"
          }
        }
      }
    },
    "settings.look.icon.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Symbol auf dem Startbildschirm. Den Hinweis beim Wechsel zeigt iOS selbst — er kommt vom System, nicht von CineLounge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The icon on your Home Screen. iOS shows the alert when it changes — that comes from the system, not from CineLounge."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana ekrandaki simge. Değişim uyarısını iOS kendisi gösterir — o sistemden gelir, CineLounge'dan değil."
          }
        }
      }
    },
    "settings.look.icon.main": {
