    "storage.reconcileWhy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Findet Dateien, von denen kein Eintrag mehr weiß — etwa nach einem Abbruch durch das System."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds files no entry knows about any more — for instance after the system cancelled a download."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artık hiçbir kaydın bilmediği dosyaları bulur — örneğin sistem bir indirmeyi iptal ettikten sonra."
          }
        }
      }
    },
    "storage.reserveText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads bleiben liegen, bis du sie löschst. Alles andere ist Zwischenspeicher und kommt beim nächsten Öffnen wieder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads stay until you delete them. Everything else is cache and comes back next time you open the app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilenler siz silene kadar kalır. Geri kalanı önbellektir ve uygulamayı bir sonraki açışınızda geri gelir."
          }
        }
      }
    },
    "storage.stays": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt, bis du löschst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stays until you delete"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz silene kadar kalır"
          }
        }
      }
    },
    "storage.staysWhy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gelöschter Film kommt nicht wieder — ein gelöschtes Plakat schon. Deshalb stehen beide nicht untereinander."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A deleted film does not come back — a deleted poster does. That is why the two are not listed together."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silinen bir film geri gelmez — silinen bir afiş gelir. İkisi bu yüzden yan yana durmuyor."
          }
        }
      }
    },
