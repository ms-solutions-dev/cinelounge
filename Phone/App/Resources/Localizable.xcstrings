    "stock.resumable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "fortsetzbar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "resumable"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "sürdürülebilir"
          }
        }
      }
    },
    "stock.resumableWhy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum eine Quelle „setzt nicht fort“ sein kann: Vor dem ersten Byte fragt die App mit einer Bereichsanfrage nach. Antwortet der Host nicht entsprechend, beginnt jeder Abbruch von vorn — über eine schwache Zelle ist das der Unterschied zwischen „später fertig“ und „nie fertig“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why a source can be “not resumable”: before the first byte the app sends a range request. If the host does not answer accordingly, every interruption starts over — over a weak cell that is the difference between “done later” and “never done”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kaynağın neden “sürdürülemez” olabileceği: ilk bayttan önce uygulama bir aralık isteği gönderir. Sunucu buna uygun yanıt vermezse her kesinti baştan başlar — zayıf hücrede bu, “sonra biter” ile “hiç bitmez” arasındaki farktır."
          }
        }
      }
    },
    "stock.resume": {
