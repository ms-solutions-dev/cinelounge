    "settings.portals.shared.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An heißt: Diese Mediathek führt „Weiterschauen“ und Favoriten in ihrem eigenen Bereich unter CL-Server und nicht auf der Startseite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On means: this library keeps “Continue watching” and favourites in its own area under CL-Server, not on the home screen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık: Bu kütüphane „İzlemeye devam et“ ve favorileri ana sayfada değil, CL-Server altındaki kendi alanında tutar."
          }
        }
      }
    },
    "settings.portals.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Und das ist so gewollt. Welche Mediatheken es gibt und was sie können, weiß der CL-Server im Heimnetz — die App liest es ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "And that is deliberate. Which services exist and what they can do is known to the CL server on your home network — the app just reads it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve bu bilinçlidir. Hangi servislerin olduğunu ve neler yapabildiğini ev ağındaki CL-Server bilir — uygulama yalnızca okur."
          }
        }
      }
    },
    "settings.portals.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier gibt es nichts einzustellen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is nothing to set here"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada ayarlanacak bir şey yok"
          }
        }
      }
    },
    "settings.portals.whoAreYou": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer bist du?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who are you?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen kimsin?"
          }
        }
      }
    },
    "settings.ratings.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne die Schlüssel ist nichts kaputt: Was Jellyfin mitliefert, steht ohnehin auf jeder Kachel. Sie kaufen die genauere Auskunft, nicht die Auskunft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without the keys nothing is broken: what Jellyfin delivers is on every tile anyway. They buy the more precise answer, not the answer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtarlar olmadan hiçbir şey bozulmaz: Jellyfin’in verdiği zaten her kartta durur. Onlar daha kesin yanıtı satın alır, yanıtı değil."
          }
        }
      }
    },
    "settings.ratings.mal": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MyAnimeList"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MyAnimeList"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MyAnimeList"
          }
        }
      }
    },
    "settings.ratings.malText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bringt die Anime-Wertung je Staffel. Die Client-ID gibt es kostenlos unter myanimelist.net/apiconfig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brings the anime score per season. The client ID is free at myanimelist.net/apiconfig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sezon başına anime puanını getirir. Client ID myanimelist.net/apiconfig adresinde ücretsizdir."
          }
        }
      }
    },
    "settings.ratings.omdb": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OMDb"
