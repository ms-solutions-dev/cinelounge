    },
    "about.privacyText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App legt kein Konto bei uns an. Sie meldet sich an deinem Server an, und was sie speichert, liegt auf diesem Gerät — nachzusehen und zu löschen unter Speicher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app does not create an account with us. It signs in to your own server, and what it stores stays on this device — see and delete it under Storage."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulama bizde hesap açmaz. Kendi sunucunuza bağlanır ve sakladığı her şey bu cihazda kalır — Depolama altında görebilir ve silebilirsiniz."
          }
        }
      }
    },
    "about.report": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender oder Titel melden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report a channel or title"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal veya içerik bildir"
          }
        }
      }
    },
    "about.reportText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was über eine eigene Liste hereinkommt, prüft vorher niemand."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing that arrives through your own playlist is checked in advance."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi listenizden gelen içerikler önceden denetlenmez."
          }
        }
      }
    },
