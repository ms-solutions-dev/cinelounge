    "portal.whyNoAdding": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Liste kommt vom CL-Server, und die App kann ihr nichts hinzufügen. Das ist Absicht und die Antwort auf eine Regel des App Store — hier steht der Satz, damit niemand die fehlende Möglichkeit für eine Lücke hält."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This list comes from the CL-Server, and the app cannot add to it. That is deliberate and the answer to an App Store rule — the sentence is here so nobody mistakes the missing option for a gap."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu liste CL-Server’dan gelir ve uygulama ona ekleme yapamaz. Bu bilinçli bir karardır ve bir App Store kuralının yanıtıdır — eksik seçeneği bir boşluk sanmasın diye bu cümle burada duruyor."
          }
        }
      }
    },
    "portalsources.expired": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse verfallen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Address expired"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresin süresi doldu"
          }
        }
      }
    },
    "portalsources.expired.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Videoadresse des Hosts ist abgelaufen, während die App im Hintergrund war. Sie muss neu aufgelöst werden — das dauert etwa zwei Sekunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host's video address expired while the app was in the background. It has to be resolved again — that takes about two seconds."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama arka plandayken barındırıcının video adresinin süresi doldu. Yeniden çözümlenmesi gerekiyor — bu yaklaşık iki saniye sürer."
          }
        }
      }
    },
    "portalsources.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst direkt vom Host, der CL-Server nur als Rückfall — je Versuch entschieden, nicht je Mediathek. Gesperrte Hosts bleiben stehen, damit sichtbar ist, warum sie nicht gehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Straight from the host first, the CL server only as a fallback — decided per attempt, not per service. Blocked hosts stay in the list so it is visible why they do not work."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce doğrudan barındırıcıdan, CL-Server yalnızca yedek olarak — servis başına değil, deneme başına karar verilir. Engelli barındırıcılar, neden çalışmadıkları görünsün diye listede kalır."
          }
        }
      }
    },
    "portalsources.none": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Mediathek nennt für den Titel keine Quelle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This service names no source for this title."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu servis bu başlık için kaynak belirtmiyor."
          }
        }
      }
    },
