          }
        }
      }
    },
    "pairing.pairAction": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Code am anderen Gerät scannen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the code on the other device"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer cihazdaki kodu tara"
          }
        }
      }
    },
    "pairing.remove": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaldır"
          }
        }
      }
    },
    "pairing.scanText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte die Kamera auf den Code, der auf dem anderen Gerät steht. Was dann geschieht, sagt der Code selbst — er holt ein Profil her oder gibt deines hinüber."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point the camera at the code shown on the other device. What happens next is in the code itself — it either fetches a profile or hands yours over."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerayı diğer cihazda görünen koda tutun. Sonra ne olacağını kodun kendisi söyler — ya bir profil getirir ya da seninkini aktarır."
          }
        }
      }
    },
    "pairing.sharedByLabel": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geteilt von"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared by"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşan"
          }
        }
      }
    },
    "pairing.wouldGive %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sucht das andere Gerät ein Profil, wird %@ hergegeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the other device is looking for a profile, %@ will be handed over."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer cihaz bir profil arıyorsa %@ aktarılacak."
          }
        }
      }
    },
    "place.library.jellyfin.away": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Jellyfin läuft durch den Tunnel** — als einzige der drei Quellen. Dafür rechnet der Server um: unterwegs 720p statt 1080p. Wie viel der Tunnel wirklich trägt, ist noch ungemessen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Jellyfin goes through the tunnel** — the only one of the three sources. In return the server transcodes: 720p on the road instead of 1080p. How much the tunnel really carries is still unmeasured."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Jellyfin tünelden geçiyor** — üç kaynaktan tek o. Karşılığında sunucu dönüştürüyor: yolda 1080p yerine 720p. Tünelin gerçekte ne taşıdığı henüz ölçülmedi."
          }
        }
      }
    },
    "place.library.jellyfin.home": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Jellyfin steht im Haus.** Volle Auflösung, kein Umweg, kein Umrechnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Jellyfin is in the house.** Full resolution, no detour, no transcoding."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Jellyfin evde.** Tam çözünürlük, dolambaç yok, dönüştürme yok."
          }
        }
      }
    },
    "place.library.xtream.away": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Xtream ist unterwegs unverändert** — die Anbieteradresse liegt im Internet, nicht im Haus. Drosseln geht nicht: Es gibt genau einen Strom je Titel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Xtream is unchanged on the road** — the provider's address is on the internet, not in the house. Throttling isn't possible: there is exactly one stream per title."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Xtream yolda da aynı** — sağlayıcının adresi internette, evde değil. Kısmak mümkün değil: her başlık için tam olarak bir akış var."
          }
        }
      }
    },
    "place.library.xtream.home": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Xtream kommt aus dem Internet**, nicht aus dem Haus. Feste Ströme des Anbieters — und nur **eine** Verbindung gleichzeitig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Xtream comes from the internet**, not from the house. Fixed streams from the provider — and only **one** connection at a time."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Xtream internetten geliyor**, evden değil. Sağlayıcının sabit akışları — ve aynı anda yalnızca **bir** bağlantı."
          }
        }
      }
    },
    "place.live.away": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Sender laufen unterwegs wie zu Hause.** Sie kommen direkt vom Anbieter. Absenken lässt sich nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Channels run the same on the road as at home.** They come straight from the provider. Nothing can be lowered."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Kanallar yolda da evdeki gibi çalışır.** Doğrudan sağlayıcıdan gelirler. Düşürülecek bir şey yok."
          }
        }
      }
    },
    "place.live.away.busy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Sender laufen unterwegs wie zu Hause.** Sie kommen direkt vom Anbieter. Absenken lässt sich nichts. Der Apple TV belegt die eine erlaubte Verbindung — belegte Sender stehen deshalb mit Zustand statt mit Restzeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Channels run the same on the road as at home.** They come straight from the provider. Nothing can be lowered. The Apple TV is using the one permitted connection — busy channels therefore show a state instead of a remaining time."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Kanallar yolda da evdeki gibi çalışır.** Doğrudan sağlayıcıdan gelirler. Düşürülecek bir şey yok. İzin verilen tek bağlantıyı Apple TV kullanıyor — meşgul kanallar bu yüzden kalan süre yerine durum gösteriyor."
          }
        }
      }
    },
    "place.live.home": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Eine Verbindung, ein Bild.** Das Xtream-Konto erlaubt genau eine gleichzeitige Wiedergabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**One connection, one picture.** The Xtream account allows exactly one playback at a time."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Bir bağlantı, bir görüntü.** Xtream hesabı aynı anda tam olarak bir oynatmaya izin veriyor."
          }
        }
      }
    },
    "place.live.home.busy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Eine Verbindung, ein Bild.** Das Xtream-Konto erlaubt genau eine gleichzeitige Wiedergabe. Der Apple TV belegt sie gerade — belegte Sender stehen deshalb mit Zustand statt mit Restzeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**One connection, one picture.** The Xtream account allows exactly one playback at a time. The Apple TV is using it — busy channels therefore show a state instead of a remaining time."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Bir bağlantı, bir görüntü.** Xtream hesabı aynı anda tam olarak bir oynatmaya izin veriyor. Şu anda onu Apple TV kullanıyor — meşgul kanallar bu yüzden kalan süre yerine durum gösteriyor."
          }
        }
      }
    },
    "place.portals.away": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Unterwegs kaum betroffen:** Durch den Tunnel gehen nur ein paar Kilobyte Katalog. Das Video kommt direkt vom Host — außer bei einer 403 gegen IPv6, dann doch über den CL-Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Barely affected on the road:** only a few kilobytes of catalogue go through the tunnel. The video comes straight from the host — except on a 403 against IPv6, then through the CL-Server after all."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Yolda neredeyse etkilenmez:** tünelden yalnızca birkaç kilobayt katalog geçer. Video doğrudan barındırıcıdan gelir — IPv6'ya 403 dönerse yine de CL-Server üzerinden."
          }
        }
      }
    },
    "place.portals.home": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Der Katalog kommt aus dem Haus**, das Video vom Host im Internet. Über den CL-Server läuft nur der Rückfall."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**The catalogue comes from the house**, the video from the host on the internet. Only the fallback runs through the CL-Server."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Katalog evden geliyor**, video internetteki barındırıcıdan. CL-Server üzerinden yalnızca geri dönüş yolu geçer."
          }
        }
      }
    },
    "place.search.away": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Xtream und der CL-Server antworten wie zu Hause. **Nur Jellyfin geht durch den Tunnel** — bei ihm dauert es länger, und die Bilder kommen kleiner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xtream and the CL server answer as they do at home. **Only Jellyfin goes through the tunnel** — there it takes longer, and the images arrive smaller."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xtream ve CL-Server evdeki gibi yanıt verir. **Yalnızca Jellyfin tünelden geçer** — orada daha uzun sürer ve görseller daha küçük gelir."
          }
        }
      }
    },
    "place.search.child": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesucht wird in **deiner Mediathek** — in dem, was dieses Konto sehen darf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searching **your library** — in what this account is allowed to see."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arama **senin kitaplığında** — bu hesabın görmesine izin verilenlerde."
          }
        }
      }
    },
    "place.search.home": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Bestände auf einmal: **Jellyfin** im Haus, **Xtream** im Internet, **CL-Server** im Heimnetz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three collections at once: **Jellyfin** in the house, **Xtream** on the internet, **CL server** on the home network."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı anda üç kaynak: evde **Jellyfin**, internette **Xtream**, ev ağında **CL-Server**."
          }
        }
      }
    },
    "place.sources.away": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterwegs heißt **Automatisch** nicht „so gut wie möglich“, sondern **720p**, vom Server umgerechnet. Ein Telefon braucht auf sechs Zoll keine 4K."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the road, **Automatic** doesn't mean “as good as possible” but **720p**, transcoded by the server. A phone doesn't need 4K on six inches."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yolda **Otomatik**, “mümkün olduğunca iyi” değil, sunucunun dönüştürdüğü **720p** demektir. Altı inçlik bir telefonun 4K'ya ihtiyacı yok."
          }
        }
      }
    },
    "place.sources.home": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu Hause heißt **Automatisch**: 1080p direkt vom Server, ohne Umrechnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At home, **Automatic** means 1080p straight from the server, without transcoding."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evde **Otomatik** demek, dönüştürme olmadan doğrudan sunucudan 1080p demek."
          }
        }
      }
    },
