          }
        }
      }
    },
    "childLock.tabs": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reiterleiste bei Gerätesperre"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab bar with the device lock"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz kilidinde sekme çubuğu"
          }
        }
      }
    },
    "childLock.tabs.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein abgeschalteter Reiter verschwindet, er wird nicht abgeblendet. Für Sender und den CL-Server gibt es keine Freigaben — es gibt dort nichts, woran eine Grenze liegen könnte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A switched-off tab disappears, it is not dimmed. Channels and the CL server carry no ratings — there is nothing there for a limit to hold on to."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapatılan bir sekme kaybolur, soluklaştırılmaz. Kanallarda ve CL-Server’da derece yoktur — orada bir sınırın tutunabileceği hiçbir şey yok."
          }
        }
      }
    },
