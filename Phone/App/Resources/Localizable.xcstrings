    "childLock.account.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Konto hat seine eigene Grenze. Ein Wechsel zu einem Konto ohne Grenze verlangt die PIN."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every account has its own limit. Switching to an account without one asks for the PIN."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her hesabın kendi sınırı vardır. Sınırsız bir hesaba geçiş PIN ister."
          }
        }
      }
    },
    "childLock.account.name": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angemeldet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed in"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum açık"
          }
        }
      }
    },
    "childLock.account.none": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto angemeldet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account signed in"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum açmış hesap yok"
          }
        }
      }
    },
    "childLock.account.none.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Grenze gilt trotzdem — sie hängt an diesem Gerät und nicht am Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The limit still applies — it belongs to this device, not to an account."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınır yine de geçerli — hesaba değil, bu cihaza bağlıdır."
          }
        }
      }
    },
    "childLock.adult.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorgabe: ausgeblendet. Die Kennzeichnung kommt vom Anbieter und kann unvollständig sein. Wer sich darauf verlässt, sollte das wissen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default: hidden. The marking comes from the provider and can be incomplete. Anyone relying on it should know that."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan: gizli. İşaretleme sağlayıcıdan gelir ve eksik olabilir. Buna güvenen bunu bilmeli."
          }
        }
      }
    },
    "childLock.adult.m3u": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "M3U-Listen kennzeichnen nichts"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "M3U lists mark nothing"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "M3U listeleri hiçbir şey işaretlemez"
          }
        }
      }
    },
    "childLock.adult.m3u.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Feld, auf das sich der Schalter stützt, gibt es nur bei Xtream. Sender aus einer M3U-Liste gelten deshalb als ungekennzeichnet — nicht als harmlos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The field the switch relies on exists only with Xtream. Channels from an M3U list therefore count as unmarked — not as harmless."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtarın dayandığı alan yalnızca Xtream’de vardır. Bu yüzden M3U listesindeki kanallar işaretsiz sayılır — zararsız değil."
          }
        }
      }
    },
    "childLock.ask.repeat.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zur Sicherheit dieselben vier Ziffern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same four digits, to be sure."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Emin olmak için aynı dört hane."
          }
        }
      }
    },
    "childLock.door.erwachsenensender": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erwachsenensender"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adult channels"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yetişkin kanalları"
          }
        }
      }
    },
    "childLock.doors.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was die PIN nicht sperrt: das Gerät selbst, den Browser und jede andere App. Sie ist eine Grenze in CineLounge, kein Jugendschutz für das Gerät — dafür ist die Bildschirmzeit von iOS da, und die sagt es ehrlicher als wir es könnten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the PIN does not lock: the device itself, the browser and every other app. It is a boundary inside CineLounge, not device-wide parental control — that is what iOS Screen Time is for, and it says so more honestly than we could."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN’in kilitlemediği şeyler: cihazın kendisi, tarayıcı ve diğer tüm uygulamalar. O, CineLounge içinde bir sınırdır, cihaz genelinde bir koruma değil — bunun için iOS Ekran Süresi var ve o bunu bizden daha dürüst söylüyor."
          }
        }
      }
    },
    "childLock.forgot.delete": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App zu löschen hilft nicht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting the app does not help"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı silmek işe yaramaz"
          }
        }
      }
    },
    "childLock.forgot.delete.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die PIN liegt im Schlüsselbund und überlebt das Neuinstallieren — sonst wäre sie in fünf Sekunden umgangen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PIN lives in the keychain and survives a reinstall — otherwise it would be bypassed in five seconds."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN anahtar zincirinde durur ve yeniden kurulumdan sağ çıkar — yoksa beş saniyede aşılırdı."
          }
        }
      }
    },
    "childLock.forgot.noDeviceHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dann wird die Kindersicherung nach 24 Stunden zurückgesetzt. Die Frist steht hier, und jedes Gerät dieser Apple-ID kann sie abbrechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then parental controls reset after 24 hours. The countdown shows here, and any device on this Apple ID can cancel it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O zaman ebeveyn denetimi 24 saat sonra sıfırlanır. Geri sayım burada görünür ve bu Apple Kimliğindeki her cihaz iptal edebilir."
          }
        }
      }
    },
    "childLock.forgot.otherDevice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem anderen Gerät bestätigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm on another device"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir cihazda onayla"
          }
        }
      }
    },
    "childLock.limit %lld": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ab %lld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld+"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld+"
          }
        }
      }
    },
    "childLock.limit.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel über der Grenze erscheinen nicht in Bibliothek, Suche und auf der Startseite. Sie sind nicht ausgegraut, sie sind nicht da — ein gesperrter Titel, der sichtbar bleibt, ist eine Einladung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Titles above the limit do not appear in the library, in search or on the home screen. They are not greyed out, they are absent — a blocked title that stays visible is an invitation."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınırın üstündeki başlıklar kitaplıkta, aramada ve ana ekranda görünmez. Soluklaştırılmaz, hiç yoktur — görünür kalan engelli bir başlık bir davettir."
          }
        }
      }
    },
    "childLock.on.needsPin": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erst eine PIN vergeben — ohne sie sperrt nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a PIN first — without one, nothing is locked."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce bir PIN belirle — PIN olmadan hiçbir şey kilitli değil."
          }
        }
      }
    },
    "childLock.pin": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN"
          }
        }
      }
    },
    "childLock.pin.digits %lld": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld-stellig"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld digit"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld digits"
                }
              }
            }
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld haneli"
          }
        }
      }
    },
    "childLock.pin.dots": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingegebene Stellen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Digits entered"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girilen hane"
          }
        }
      }
    },
    "childLock.pin.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die PIN liegt im Schlüsselbund dieses Geräts. Sie steht nicht auf dem Server und gilt nur hier — auf einem zweiten Gerät wird sie neu vergeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PIN lives in this device’s keychain. It is not stored on the server and applies here only — on a second device you set a new one."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN bu cihazın anahtar zincirinde durur. Sunucuda tutulmaz ve yalnızca burada geçerlidir — ikinci bir cihazda yeniden belirlenir."
          }
        }
      }
    },
    "childLock.pin.invalid": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier Ziffern, sonst nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four digits, nothing else."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dört hane, başka bir şey değil."
          }
        }
      }
    },
    "childLock.pin.none": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "noch keine"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "not set yet"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "henüz yok"
          }
        }
      }
    },
    "childLock.ratings.allUnderstood": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles eingeordnet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything sorted"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey sınıflandırıldı"
          }
        }
      }
    },
    "childLock.ratings.allUnderstood.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Freigabe dieses Bestands ließ sich deuten. Das ist eine Auskunft und kein Zufall."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every rating in this stock could be interpreted. That is information, not luck."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu koleksiyondaki her derece yorumlanabildi. Bu bir bilgidir, şans değil."
          }
        }
      }
    },
    "childLock.ratings.assign.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Stufe meint diese Angabe? Die Zuordnung gilt für alle Konten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which level does this rating mean? The assignment applies to all accounts."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu derece hangi seviyeyi anlatıyor? Eşleme tüm hesaplar için geçerlidir."
          }
        }
      }
    },
    "childLock.ratings.blockUnknown": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unverstandene Freigaben sperren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block ratings we don’t understand"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anlaşılmayan dereceleri engelle"
          }
        }
      }
    },
    "childLock.ratings.blockUnknown.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was die App nicht einordnen kann, bleibt weg, bis du es zuordnest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anything the app cannot place stays hidden until you sort it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın yerleştiremediği her şey, sen sınıflandırana kadar gizli kalır."
          }
        }
      }
    },
    "childLock.ratings.blocked": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "gesperrt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "blocked"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "engelli"
          }
        }
      }
    },
    "childLock.ratings.byHand": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "von Hand"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "by hand"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "elle"
          }
        }
      }
    },
    "childLock.ratings.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Freigabe kommt als Rohtext vom Server und ist nicht genormt: „FSK 16“, „TV-MA“, „12“, „Not Rated“ — alles ist möglich, auch nichts. CineLounge rät nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rating arrives as raw text from the server and is not standardised: “FSK 16”, “TV-MA”, “12”, “Not Rated” — anything is possible, including nothing. CineLounge does not guess."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Derece sunucudan ham metin olarak gelir ve standart değildir: „FSK 16“, „TV-MA“, „12“, „Not Rated“ — her şey mümkün, hiçbir şey de. CineLounge tahmin yürütmez."
          }
        }
      }
    },
    "childLock.ratings.intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links steht, was der Server liefert. Rechts, was CineLounge daraus macht. Die Angaben sind nicht genormt — jeder Server, jeder Anbieter und jede Datei kann etwas anderes schreiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the left, what the server delivers. On the right, what CineLounge makes of it. The ratings are not standardised — every server, every provider and every file can write something different."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Solda sunucunun verdiği. Sağda CineLounge’un ondan çıkardığı. Dereceler standart değildir — her sunucu, her sağlayıcı ve her dosya başka bir şey yazabilir."
          }
        }
      }
    },
    "childLock.ratings.loading": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freigaben werden gezählt …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counting ratings …"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dereceler sayılıyor …"
          }
        }
      }
    },
    "childLock.ratings.noRatings": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender und CL-Server haben keine Freigabe"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Channels and the CL server carry no rating"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanallarda ve CL-Server’da derece yok"
          }
        }
      }
    },
    "childLock.ratings.noRatings.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie tragen keine Altersangabe, und der CL-Server liefert keine. Für sie gibt es hier nichts zuzuordnen — dort hilft nur, den ganzen Bereich abzuschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They carry no age rating, and the CL server delivers none. There is nothing to assign for them here — the only remedy there is switching off the whole area."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaş bilgisi taşımazlar ve CL-Server da vermez. Onlar için burada eşlenecek bir şey yok — orada yalnızca tüm alanı kapatmak yardımcı olur."
          }
        }
      }
    },
    "childLock.ratings.open %lld": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht eingeordnet · %lld Titel"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Unsorted · %lld title"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Unsorted · %lld titles"
                }
              }
            }
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınıflandırılmadı · %lld başlık"
          }
        }
      }
    },
    "childLock.ratings.open.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange „Unverstandene Freigaben sperren“ eingeschaltet ist, sind diese Titel nicht da. Einmal zugeordnet, gilt die Zuordnung für alle Konten und bleibt beim nächsten Abgleich stehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As long as “Block ratings we don’t understand” is on, these titles are absent. Once assigned, the assignment applies to all accounts and survives the next sync."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "„Anlaşılmayan dereceleri engelle“ açıkken bu başlıklar yoktur. Bir kez eşlendiğinde eşleme tüm hesaplar için geçerlidir ve sonraki eşitlemede kalır."
          }
        }
      }
    },
