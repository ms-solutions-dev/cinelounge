    "portal.setting.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mediathek braucht eine Angabe, die noch leer ist. Sie lässt sich in ihren Einstellungen eintragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The portal needs a value that is still empty. You can enter it in the portal's settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Portalın henüz boş olan bir bilgiye ihtiyacı var. Bunu portalın ayarlarından girebilirsin."
          }
        }
      }
    },
