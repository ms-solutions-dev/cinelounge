    "stock.sizeUnknownWhy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie groß das wird, sagt diese Quelle vorher nicht: Sie nennt keine Laufzeit, und ohne Laufzeit wäre jede Zahl hier geraten. Die echte Größe steht in der Vorratszeile, sobald der erste Block da ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This source doesn’t say how large this will be: it gives no running time, and without one any number here would be a guess. The real size appears in the download row as soon as the first block arrives."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kaynak boyutu önceden bildirmiyor: süre vermiyor, süre olmadan da buradaki her sayı tahmin olurdu. Gerçek boyut, ilk blok geldiği anda indirme satırında görünür."
          }
        }
      }
    },
