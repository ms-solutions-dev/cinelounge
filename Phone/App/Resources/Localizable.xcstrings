    "settings.ratings.tmdbText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bringt Gesichter und Laufbahnen der Besetzung. Ohne ihn zeigen die Personenkreise Platzhalter und hören auf, Knöpfe zu sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brings the cast’s faces and filmographies. Without it the person circles show placeholders and stop being buttons."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyuncuların yüzlerini ve filmografilerini getirir. Onsuz kişi daireleri yer tutucu gösterir ve düğme olmaktan çıkar."
          }
        }
      }
    },
    "settings.search": {
      "extractionState": "manual",
      "localizations": {
