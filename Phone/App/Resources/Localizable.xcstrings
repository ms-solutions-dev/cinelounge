            "state": "translated",
            "value": "Deposited. The other device is picking the profile up now."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bırakıldı. Diğer cihaz profili şimdi alıyor."
          }
        }
      }
    },
    "pairing.pair": {
      "extractionState": "manual",
      "localizations": {
