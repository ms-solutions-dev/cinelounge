    "live.settings.browseFootnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist die Übersicht aus, öffnet „Live“ beim ersten Aufruf gleich den zuletzt gesehenen Sender. Wer den Spieler schließt, steht wieder bei den Sendern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the overview off, “Live” opens the channel you watched last the first time you go there. Closing the player brings you back to the channels."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genel bakış kapalıyken “Canlı” ilk açılışta en son izlenen kanalı hemen açar. Oynatıcıyı kapatınca yeniden kanallara dönersin."
          }
        }
      }
    },
    "live.settings.syncFootnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Abgleich fragt eine Online-Quelle nach den Anstoßzeiten. Belegte Spiele tragen ein Siegel und stehen unter „Belegt“ — eine Wiederholung ist dort ausgeschlossen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sync asks an online source for kick-off times. Confirmed matches carry a seal and appear under “Verified” — a repeat is ruled out there."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşitleme, maç saatlerini çevrimiçi bir kaynaktan sorar. Doğrulanan maçlar bir mühür taşır ve “Onaylı” altında görünür — orada tekrar yayın olamaz."
          }
        }
      }
    },
