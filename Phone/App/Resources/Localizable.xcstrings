    "stock.offlineMissing": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ohne Netz nicht geht: Bibliothek, Live, CL-Server und die Suche brauchen ihre Quelle. Heruntergeladenes liegt auf dem Gerät — gesucht wird oben, in dem, was hier liegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What needs a network: library, live, CL server and search all need their source. Downloads are the only collection on the device — search above, in what is here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağ gerektirenler: kitaplık, canlı, CL-Server ve arama kaynağına ihtiyaç duyar. İndirilenler cihazdaki tek koleksiyondur — yukarıdan, burada olanlarda arayın."
          }
        }
      }
    },
    "stock.offlineWorks": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Netz — und das hier läuft trotzdem"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No network — and this still plays"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağ yok — ama bunlar yine de oynatılır"
          }
        }
      }
    },
    "stock.oneConnection": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Laden belegt die eine Verbindung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloading uses the single connection"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirme tek bağlantıyı kullanır"
          }
        }
      }
    },
    "stock.oneConnectionBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange es läuft, kann der Apple TV nicht spielen — und umgekehrt wartet das Laden, wenn dort etwas läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While it runs the Apple TV cannot play — and conversely the download waits while something plays there."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışırken Apple TV oynatamaz — tersine, orada bir şey oynarken indirme bekler."
          }
        }
      }
    },
    "stock.oneGoNoResume": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Fassung kommt nur am Stück — ein Abbruch beginnt von vorn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version only comes in one go — an interruption starts over."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sürüm yalnızca tek seferde geliyor — kesinti olursa baştan başlar."
          }
        }
      }
    },
    "stock.paused": {
      "extractionState": "manual",
      "localizations": {
