    "settings.ratings.omdbText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bringt IMDb, Rotten Tomatoes, Metacritic und Auszeichnungen. Im freien Zugang tausend Abfragen am Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brings IMDb, Rotten Tomatoes, Metacritic and awards. A thousand requests a day on the free tier."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "IMDb, Rotten Tomatoes, Metacritic ve ödülleri getirir. Ücretsiz erişimde günde bin sorgu."
          }
        }
      }
    },
