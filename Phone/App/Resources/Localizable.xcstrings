    "portal.silent.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der CL-Server erreicht sie gerade nicht. Eine andere Mediathek geht wahrscheinlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The CL server cannot reach it right now. Another service will probably work."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CL-Server şu anda ona ulaşamıyor. Başka bir servis büyük olasılıkla çalışır."
          }
        }
      }
    },
    "portal.silent.title": {
      "extractionState": "manual",
      "localizations": {
