    "childLock.reset.confirm": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt bestätigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm now"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi onayla"
          }
        }
      }
    },
    "childLock.reset.confirmed %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für %@ ist bereits bestätigt. Beim nächsten Versuch fällt die Sperre dort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has already been confirmed. The lock will be lifted there on the next attempt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için zaten onaylandı. Bir sonraki denemede oradaki kilit kalkacak."
          }
        }
      }
    },
    "childLock.reset.due %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Frist für %@ ist abgelaufen. Beim nächsten Versuch fällt die Sperre dort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The countdown for %@ has ended. The lock will be lifted there on the next attempt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için süre doldu. Bir sonraki denemede oradaki kilit kalkacak."
          }
        }
      }
    },
    "childLock.reset.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigen hebt die Frist auf — die Sperre am Fernseher fällt sofort. Abbrechen nimmt die Anfrage zurück; wer sie nicht selbst gestellt hat, sollte das tun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirming removes the countdown — the lock on the TV is lifted right away. Cancelling withdraws the request; if you did not make it yourself, you should do that."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onaylamak süreyi kaldırır — televizyondaki kilit hemen açılır. İptal isteği geri alır; isteği siz yapmadıysanız bunu yapmalısınız."
          }
        }
      }
    },
    "childLock.reset.forProfile %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil „%@“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile “%@”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” profili"
          }
        }
      }
    },
    "childLock.reset.none": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade ist nichts offen. Wenn am Fernseher jemand „PIN vergessen\" wählt, steht es hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is pending right now. If someone selects “Forgot PIN” on the TV, it will show up here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda bekleyen bir şey yok. Televizyonda biri „PIN'i unuttum\" derse burada görünür."
          }
        }
      }
    },
    "childLock.reset.pending": {
