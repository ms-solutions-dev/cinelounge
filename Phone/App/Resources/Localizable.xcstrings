    "search.idle.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesucht wird in allem, was eingerichtet ist — auf einmal, die Sender eingeschlossen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything that is set up is searched at once — channels included."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurulu olan her şeyde aynı anda arama yapılır — kanallar da dahil."
          }
        }
      }
    },
    "search.idle.title": {
