    "settings.diagnostics.whatIsSent": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bericht enthält Gerät, Fassung und die letzten Einträge. Adressen werden dabei geschwärzt — wo „://“ vorkommt, geht der ganze Text nicht hinaus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The report holds device, version and the last entries. Addresses are redacted — where “://“ appears, the whole text stays here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapor aygıt, sürüm ve son kayıtları içerir. Adresler karartılır — „://“ geçen metin dışarı çıkmaz."
          }
        }
      }
    },
