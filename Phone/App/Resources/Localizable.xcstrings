    "childLock.server.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was dieses Konto in Jellyfin sehen darf, entscheidet der Server, und er tut es zuverlässiger als jede App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What this account may see in Jellyfin is the server’s decision, and it makes it more reliably than any app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesabın Jellyfin’de neyi görebileceğine sunucu karar verir ve bunu her uygulamadan daha güvenilir yapar."
          }
        }
      }
    },
    "childLock.server.has": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richtlinie gelesen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Policy read"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlke okundu"
          }
        }
      }
    },
    "childLock.server.none": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server führt für dieses Konto keine Grenze"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server keeps no limit for this account"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu bu hesap için sınır tutmuyor"
          }
        }
      }
    },
    "childLock.server.none.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gefragt wurde er — die Antwort war leer. Dann gilt nur, was hier eingestellt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It was asked — the answer was empty. Then only what is set here applies."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soruldu — yanıt boştu. O zaman yalnızca burada ayarlanan geçerlidir."
          }
        }
      }
    },
    "childLock.server.others": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender, CL-Server und Xtream: keine Richtlinie"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Channels, CL server and Xtream: no policy"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanallar, CL-Server ve Xtream: ilke yok"
          }
        }
      }
    },
    "childLock.server.others.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin kennt sie nicht. Dort gilt nur, was hier eingestellt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin does not know them. There, only what is set here applies."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin onları tanımaz. Orada yalnızca burada ayarlanan geçerlidir."
          }
        }
      }
    },
    "childLock.server.restricted": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto eingeschränkt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "account restricted"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "hesap kısıtlı"
          }
        }
      }
    },
    "childLock.server.upTo %lld": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freigabe bis %lld"
          }
        },
        "en": {
