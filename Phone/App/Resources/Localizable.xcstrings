    "report.contactText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Macht die App selbst etwas falsch — ein Bild an der falschen Stelle, eine Sperre, die nicht greift —, dann schick den Diagnosebericht aus dem Bereich Diagnose. Er landet in deinem eigenen Jellyfin, und du entscheidest, wer ihn sieht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the app itself gets something wrong — an image in the wrong place, a lock that does not hold — send the diagnostic report from the Diagnostics section. It lands in your own Jellyfin, and you decide who sees it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın kendisi bir şeyi yanlış yapıyorsa — yanlış yerde bir görsel, tutmayan bir kilit — Tanı bölümünden tanı raporunu gönder. Kendi Jellyfin’inize gider ve onu kimin göreceğine siz karar verirsiniz."
          }
        }
      }
    },
    "report.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du hier siehst, kommt aus deinen eigenen IPTV-Zugängen und deinem CL-Server. Wir führen keinen Katalog, aus dem sich ein Titel entfernen ließe — und niemand außer dir hat entschieden, was hereinkommt. Was wirklich hilft, steht deshalb hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you see here comes from your own IPTV accounts and your CL server. We keep no catalogue a title could be removed from — and nobody but you decided what comes in. So here is what actually helps."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada gördükleriniz kendi IPTV erişimlerinizden ve CL-Server’ınızdan gelir. Bir içeriğin kaldırılabileceği bir katalog tutmuyoruz — ve neyin geleceğine sizden başkası karar vermedi. Gerçekten yardımcı olan şeyler burada."
          }
        }
      }
    },
    "report.yourself": {
      "extractionState": "manual",
      "localizations": {
        "de": {
