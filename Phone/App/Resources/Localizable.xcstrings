    "storage.manageWhy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dort liegt jeder geladene Titel einzeln: antippen löscht einen, „Auswählen“ mehrere oder alle auf einmal."
          }
        },
        "en": {
