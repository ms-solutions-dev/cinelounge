    "settings.search.none.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesucht wird in den Namen der Einstellungen und in den Sätzen darunter. Mit einem kürzeren Wort findet sich oft mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The search covers the names of the settings and the sentences below them. A shorter word often finds more."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arama, ayarların adlarında ve altlarındaki cümlelerde yapılır. Daha kısa bir kelime çoğu zaman daha fazlasını bulur."
          }
        }
      }
    },
