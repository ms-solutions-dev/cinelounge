    "settings.lists.empty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein IPTV-Zugang. Ohne einen bleibt der Live-Bereich leer — Jellyfin und der CL-Server sind davon nicht betroffen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No IPTV account yet. Without one the Live section stays empty — Jellyfin and the CL server are unaffected."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz IPTV erişimi yok. Biri olmadan Canlı bölümü boş kalır — Jellyfin ve CL-Server bundan etkilenmez."
          }
        }
      }
    },
    "settings.lists.guide": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Programmzeitschrift"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Programme guide"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayın rehberi"
          }
        }
      }
    },
    "settings.lists.guideText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Getrennt vom Zugang, weil beides getrennt kaputtgehen kann: Ein Anbieter, dessen Sender laufen und dessen Programm fehlt, braucht keinen neuen Zugang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept separate from the access, because the two break separately: a provider whose channels work and whose guide is missing does not need a new account."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişimden ayrı tutulur, çünkü ikisi ayrı ayrı bozulabilir: kanalları çalışan ama rehberi eksik bir sağlayıcı için yeni hesap gerekmez."
          }
        }
      }
    },
    "settings.lists.guideURL": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "XMLTV-Adresse — leer heißt: die des Zugangs"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "XMLTV address — empty means the provider’s"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "XMLTV adresi — boşsa sağlayıcınınki"
          }
        }
      }
    },
    "settings.lists.jellyfin": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus Jellyfin"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From Jellyfin"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin’den"
          }
        }
      }
    },
    "settings.lists.passKeep": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kennwort — leer lassen, um es zu behalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password — leave empty to keep it"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parola — korumak için boş bırakın"
          }
        }
      }
    },
    "settings.lists.passKeepText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das hinterlegte Kennwort wird nicht angezeigt. Leer lassen heißt: Es bleibt, wie es ist. Nur wer etwas einträgt, ersetzt es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The stored password is not shown. Leaving it empty means it stays as it is. Only what you type replaces it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı parola gösterilmez. Boş bırakmak, olduğu gibi kalması demektir. Yalnızca yazdığınız şey onu değiştirir."
          }
        }
      }
    },
    "settings.live": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı"
          }
        }
      }
    },
    "settings.live.adult.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schalter steht dort und nicht hier, weil er je Konto gilt. Vorgabe: ausgeblendet. Beim geprüften Anbieter sind 294 von 5.389 Sendern so gekennzeichnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The switch is there and not here because it applies per account. Default: hidden. With the provider we checked, 294 of 5,389 channels carry the marking."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar burada değil orada, çünkü hesap başına geçerli. Varsayılan: gizli. İncelenen sağlayıcıda 5.389 kanaldan 294ü böyle işaretli."
          }
        }
      }
    },
    "settings.live.adult.footnote2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kennzeichnung kommt vom Anbieter und kann unvollständig sein. Wer sich darauf verlässt, sollte das wissen. M3U-Listen tragen die Angabe gar nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The marking comes from the provider and can be incomplete. Anyone relying on it should know that. M3U lists do not carry the field at all."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşaretleme sağlayıcıdan gelir ve eksik olabilir. Buna güvenen bunu bilmeli. M3U listelerinde bu alan hiç yoktur."
          }
        }
      }
    },
    "settings.live.area.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne IPTV-Zugang ist hier ohnehin nichts zu sehen. Ausblenden räumt die Reiterleiste auf — der Reiter fehlt dann, weil du es willst, und nicht, weil etwas fehlt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without an IPTV account there is nothing here anyway. Hiding tidies up the tab bar — the tab is then missing because you want it so, not because something is missing."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "IPTV erişimi yoksa burada zaten görecek bir şey yok. Gizlemek sekme çubuğunu toplar — sekme o zaman istediğin için eksiktir, bir şey eksik olduğu için değil."
          }
        }
      }
    },
