    "stock.qualityWhy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum es nicht „so gut wie möglich“ heißt: Dieselbe Staffel in 4K wären rund 12 GB und über eine mobile Zelle etwa neun Stunden. Auf sechs Zoll ist sie von 1080p nicht zu unterscheiden — die Wahl muss trotzdem zu sehen sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why it is not “as good as possible”: the same season in 4K is about 12 GB and roughly nine hours over a mobile cell. On six inches it is indistinguishable from 1080p — but the choice must still be visible."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neden “mümkün olan en iyi” değil: aynı sezon 4K’da yaklaşık 12 GB ve mobil hücrede kabaca dokuz saat. Altı inçte 1080p’den ayırt edilemez — yine de seçim görünür olmalı."
          }
        }
      }
    },
