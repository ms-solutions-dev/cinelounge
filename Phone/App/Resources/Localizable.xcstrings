    },
    "accounts.move.before": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisher:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previously:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki:"
          }
        }
      }
    },
    "accounts.move.certNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert sich mit der Adresse auch das Zertifikat, fragt CineLounge einmal nach — mit dem alten und dem neuen Fingerabdruck nebeneinander."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the certificate changes along with the address, CineLounge asks once — showing the old and the new fingerprint side by side."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresle birlikte sertifika da değişirse CineLounge bir kez sorar — eski ve yeni parmak izini yan yana gösterir."
          }
        }
      }
    },
    "accounts.move.change": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse dieses Servers ändern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change this server’s address"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sunucunun adresini değiştir"
          }
        }
      }
    },
    "accounts.move.check": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse prüfen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check address"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresi denetle"
          }
        }
      }
    },
    "accounts.move.done": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umgezogen. Die Zugangsmarke gilt weiter — angemeldet bleibst du."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moved. The access token still applies — you stay signed in."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşındı. Erişim jetonu geçerli kalıyor — oturumun açık kalır."
          }
        }
      }
    },
    "accounts.move.moved": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%d Zugänge zeigen auf die neue Adresse"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d accesses now point to the new address"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%d erişim artık yeni adresi gösteriyor"
          }
        }
      }
    },
    "accounts.move.other": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist ein anderer Server und kein Umzug. Er gehört unter „Zweiten Server hinzufügen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is a different server, not a move. It belongs under “Add a second server”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu farklı bir sunucu, taşınma değil. “İkinci sunucu ekle” altına aittir."
          }
        }
      }
    },
    "accounts.move.same": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derselbe Server. Beim Umzug bleibt alles stehen — Weiterschauen-Stand, Favoriten und Konten liegen auf ihm, nicht in seiner Adresse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same server. A move keeps everything — resume points, favourites and accounts live on it, not in its address."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı sunucu. Taşınmada her şey kalır — kaldığın yer, favoriler ve hesaplar adresinde değil, sunucuda durur."
          }
        }
      }
    },
    "accounts.move.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Umzug ist kein zweiter Server: Dasselbe Konto unter neuer Adresse behält Fortschritt und Favoriten. Dafür muss die App zwei Adressen als denselben Server erkennen — das kommt noch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A move is not a second server: the same account at a new address keeps progress and favourites. For that the app has to recognise two addresses as the same server — that is still to come."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşınma ikinci bir sunucu değildir: yeni adresteki aynı hesap ilerlemeyi ve favorileri korur. Bunun için uygulamanın iki adresi aynı sunucu olarak tanıması gerekir — bu henüz yok."
          }
        }
      }
    },
    "accounts.move.unknownID": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Zugang ist angelegt worden, bevor die App die Server-Kennung mitgeschrieben hat — vergleichen lässt sich damit nichts. Einmal neu anmelden, dann steht sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This access was created before the app recorded the server identifier, so there is nothing to compare. Sign in once more and it will be there."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu erişim, uygulama sunucu kimliğini kaydetmeden önce oluşturulmuş; karşılaştırılacak bir şey yok. Bir kez yeniden giriş yap, kimlik oluşur."
          }
        }
      }
    },
    "accounts.move.warning": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist es ein anderer Server, ist es kein Umzug. Beim Umzug bleibt alles stehen; ein Wechsel auf einen anderen Server meldet ab, und damit gehen Schnappschüsse, zwischengespeicherte Bilder und Merkmarken verloren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If it is a different server, it is not a move. A move keeps everything; switching to another server signs out, and snapshots, cached images and marks are lost."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Farklı bir sunucuysa bu bir taşıma değildir. Taşımada her şey kalır; başka bir sunucuya geçmek oturumu kapatır ve anlık görüntüler, önbellekteki görseller ve işaretler kaybolur."
          }
        }
      }
    },
    "accounts.new.child": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinderkonto"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Child account"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çocuk hesabı"
          }
        }
      }
    },
    "accounts.new.childText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live und CL-Server entfallen, Freigaben werden geprüft, und der Weg zurück braucht die PIN. Das lässt sich später nicht umstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live and the CL server fall away, age ratings are enforced, and the way back needs the PIN. This cannot be changed later."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı ve CL-Server kalkar, yaş sınırları uygulanır ve geri dönüş PIN ister. Bu sonradan değiştirilemez."
          }
        }
      }
    },
    "accounts.onServer": {
