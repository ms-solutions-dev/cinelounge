    "setup.network.allow": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Heimnetz suchen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search the home network"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ev ağında ara"
          }
        }
      }
    },
    "setup.network.byHand": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse selbst eintippen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type the address myself"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresi kendim yazayım"
          }
        }
      }
    },
    "setup.network.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Wege führen weiter. Die Adresse einzutippen ist kein Notausgang — am Telefon ist es der schnellere Weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both ways lead on. Typing the address is not a fallback — on a phone it is the quicker way."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki yol da devam eder. Adresi yazmak bir kaçış yolu değildir — telefonda daha hızlı olanıdır."
          }
        }
      }
    },
    "setup.network.systemPrompt": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Nein lässt sich später nur in den Systemeinstellungen zurücknehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A “no” can afterwards only be undone in System Settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir “hayır” sonradan yalnızca Sistem Ayarları’ndan geri alınabilir."
          }
        }
      }
    },
    "setup.network.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Jellyfin im Heimnetz zu finden, ruft die App einmal ins lokale Netz. iOS fragt dafür um Erlaubnis — und die Frage kommt genau einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To find Jellyfin on your home network, the app calls into the local network once. iOS asks for permission — and it asks exactly once."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin’i ev ağında bulmak için uygulama yerel ağa bir kez seslenir. iOS bunun için izin ister — ve yalnızca bir kez sorar."
          }
        }
      }
    },
    "setup.network.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App fragt gleich nach dem lokalen Netz"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS will ask about the local network next"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama birazdan yerel ağı soracak"
          }
        }
      }
    },
    "setup.password.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein leeres Kennwort ist zulässig — Konten für Kinder sind oft so eingerichtet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An empty password is allowed — accounts for children are often set up that way."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boş parola geçerlidir — çocuk hesapları çoğu kez böyle kurulur."
          }
        }
      }
    },
    "setup.password.signingIn": {
      "extractionState": "manual",
