        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Servis açılıyor …"
          }
        }
      }
    },
    "portal.login.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mediathek meldet die Fähigkeit „anmeldung“ an. Ohne Konto zeigt sie nur das Menü, keine Folgen. Die Zugangsdaten liegen im Schlüsselbund."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service declares the “anmeldung” capability. Without an account it shows only the menu, no episodes. The credentials live in the keychain."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Servis „anmeldung“ yeteneğini bildiriyor. Hesap olmadan yalnızca menüyü gösterir, bölümleri değil. Giriş bilgileri anahtar zincirinde saklanır."
          }
        }
      }
    },
    "portal.login.title": {
      "extractionState": "manual",
      "localizations": {
