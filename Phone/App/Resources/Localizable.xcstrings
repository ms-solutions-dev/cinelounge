    "setup.playlist.address": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "URL"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "URL"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "URL"
          }
        }
      }
    },
    "setup.playlist.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugang wird abgelegt und nicht gleich geprüft: Viele Konten erlauben nur eine Verbindung, und eine überflüssige kostet Minuten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account is stored and not checked right away: many accounts allow only one connection, and a needless one costs minutes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap kaydedilir, hemen denetlenmez: birçok hesap yalnızca tek bağlantıya izin verir ve gereksiz biri dakikalara mal olur."
          }
        }
      }
    },
    "setup.playlist.m3u": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "M3U"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "M3U"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "M3U"
          }
        }
      }
    },
    "setup.playlist.name": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Name der Liste"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name of the list"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listenin adı"
          }
        }
      }
    },
    "setup.playlist.rawOnly": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Zugang liefert Sender nur als rohen Strom. Die App packt sie selbst um — ohne Zeitversatz und ohne Spulen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account only delivers channels as a raw stream. The app repackages them itself — no time shift, no seeking."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesap kanalları yalnızca ham akış olarak sunuyor. Uygulama bunları kendisi yeniden paketler — zaman kaydırma ve ileri-geri sarma olmadan."
          }
        }
      }
    },
    "setup.playlist.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
