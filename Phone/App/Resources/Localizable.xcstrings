        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This service requires a sign-in"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu servis oturum açmanızı istiyor"
          }
        }
