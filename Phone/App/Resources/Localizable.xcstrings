    "settings.portals.bridge.silent": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der CL-Server antwortet nicht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The CL-Server does not answer"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CL-Server yanıt vermiyor"
          }
        }
      }
