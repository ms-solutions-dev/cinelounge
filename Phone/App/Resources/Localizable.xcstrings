    "portal.confirm.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mediathek will etwas bestätigt haben. Antworten lässt sich hier noch nicht — der CL-Server sagt so lange Nein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service wants something confirmed. There is no way to answer here yet — until there is, the CL server says no."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Servis bir onay istiyor. Buradan henüz yanıt verilemiyor — o zamana kadar CL-Server hayır diyor."
          }
        }
      }
    },
