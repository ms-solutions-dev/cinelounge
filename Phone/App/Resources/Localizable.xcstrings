        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seven packages ship with the app, all by way of the Jellyfin SDK. It has no dependencies of its own. The list is generated from the checkouts at build time, not maintained by hand."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedi paket uygulamayla birlikte gelir, hepsi Jellyfin SDK üzerinden. Uygulamanın kendi bağımlılığı yok. Liste elle değil, derleme sırasında kaynaklardan üretilir."
          }
